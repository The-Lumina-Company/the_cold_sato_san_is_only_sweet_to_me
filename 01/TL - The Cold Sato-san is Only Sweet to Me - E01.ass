Dialogue: 0,0:00:00.00,0:00:10.00,Default,SOTA,0,0,0,,{\an4\fnLT Comical\fscx95\fscy95\bord2.2\shad2.2\blur0.6\3c&H000000&\4c&H000000&\pos(40,520)}{\c&HFF901E&}Çeviri: {\c&HFFFFFF&}Ata, shxd.{\fscy34.5}\N{\fscy95\c&HFF901E&}Redaksiyon: {\c&HFFFFFF&}shxd.{\fscy34.5}\N{\fscy95\c&HFF901E&}Encode: {\c&HFFFFFF&}shxd.{\fscy34.5}\N{\fscy95\c&HFF901E&}Upload: {\c&HFFFFFF&}shxd.{\fscy34.5}\N{\fscx76.5\fscy76.5\c&HAAAAAA&\b0}discord.gg/luminaceviri{\b1}
Dialogue: 0,0:00:15.69,0:00:17.20,Default,SOTA,0,0,0,,Beklediğiniz için teşekkür ederim.
Dialogue: 0,0:00:18.37,0:00:20.84,Default,SOTA,0,0,0,,Buyurun, ballı pankekiniz.
Dialogue: 0,0:00:20.84,0:00:22.29,Default,FEMALE CUSTOMER 1,0,0,0,,Çok güzel duruyor!
Dialogue: 0,0:00:22.29,0:00:24.31,Default,SOTA,0,0,0,,Başka bir arzunuz var mıydı?
Dialogue: 0,0:00:24.31,0:00:25.05,Default,FEMALE CUSTOMER 2,0,0,0,,Hayır, sağ olun.
Dialogue: 0,0:00:25.05,0:00:27.91,Default,SOTA,0,0,0,,Peki, lütfen tadını çıkarın!
Dialogue: 0,0:00:27.91,0:00:30.39,Default,FEMALE CUSTOMER 1 & 2,0,0,0,,Teşekkürler!
Dialogue: 0,0:00:30.61,0:00:32.42,Default,FEMALE CUSTOMER 1,0,0,0,,Ne güzel bir yer, değil mi?
Dialogue: 0,0:00:32.42,0:00:33.89,Default,FEMALE CUSTOMER 2,0,0,0,,Öyle öyle!
Dialogue: 0,0:00:33.89,0:00:37.76,Italics,SOTA,0,0,0,,Benim, Sota Oshio'nun, çalıştığım yer,
Dialogue: 0,0:00:37.76,0:00:40.62,Italics,SOTA,0,0,0,,mahalle arasında gözlerden uzak bahçeli bir kafe.
Dialogue: 0,0:00:41.03,0:00:44.15,Italics,SOTA,0,0,0,,Müşterilerimiz çoğu kadın veya çiftlerden oluşuyor,
Dialogue: 0,0:00:44.15,0:00:46.78,Italics,SOTA,0,0,0,,o yüzden tek kişilik yemekler burada pek satmaz.
Dialogue: 0,0:00:50.68,0:00:52.53,Default,KOHARU,0,0,0,,Biraz daha... geriden mi çeksem?
Dialogue: 0,0:00:52.88,0:00:56.90,Italics,SOTA,0,0,0,,Muhtemelen bu yüzden o gözüme takıldı.
Dialogue: 0,0:00:57.17,0:01:02.41,Default,KOHARU,0,0,0,,Daha geniş bir açıdan mı çeksem? \NYok, dar açı olsa?..
Dialogue: 0,0:01:02.70,0:01:03.93,Default,SOTA,0,0,0,,O!..
Dialogue: 0,0:01:04.41,0:01:07.27,Default,KOHARU,0,0,0,,Biraz daha iştah açıcı durması lazım..
Dialogue: 0,0:01:07.27,0:01:08.92,Default,KOHARU,0,0,0,,Böyle... çeksem?
Dialogue: 0,0:01:14.03,0:01:15.30,Italics,SOTA,0,0,0,,Koharu Sato.
Dialogue: 0,0:01:15.83,0:01:18.80,Italics,SOTA,0,0,0,,Benim gibi Sakuraba Lisesi'nde 2. sınıfa gidiyor.
Dialogue: 0,0:01:19.44,0:01:20.80,Flashback,FEMALE STUDENT 1,0,0,0,,Sato-san mı o?
Dialogue: 0,0:01:18.81,0:01:22.01,Flashback Top,MALE STUDENT 1,0,0,0,,Şu meşhur Sato-san\Nmı acaba?
Dialogue: 0,0:01:21.12,0:01:25.98,Italics,SOTA,0,0,0,,Okula başladığımızdan beri biraz ünlü oldu.
Dialogue: 0,0:01:27.06,0:01:29.64,Italics,SOTA,0,0,0,,Çarpıcı bakışları; kontrollü ve soğuk görünümüyle
Dialogue: 0,0:01:29.64,0:01:33.14,Italics,SOTA,0,0,0,,kız olsun erkek olsun pek çok öğrencinin kalbini kazandı...
Dialogue: 0,0:01:33.14,0:01:34.08,Italics,SOTA,0,0,0,,Ama bir yandan..
Dialogue: 0,0:01:35.12,0:01:36.56,Flashback,MALE STUDENT 2,0,0,0,,Sato-san!
Dialogue: 0,0:01:37.27,0:01:40.84,Flashback,MALE STUDENT 2,0,0,0,,Bu cumartesi, istersen bana katılıp...
Dialogue: 0,0:01:40.84,0:01:42.12,Flashback,KOHARU,0,0,0,,Niye ki?
Dialogue: 0,0:01:42.96,0:01:46.92,Flashback,KOHARU,0,0,0,,Ayrıca, seninle öyle pek bir \Ntanışıklığımız yok zaten.
Dialogue: 0,0:01:50.64,0:01:51.74,Flashback,MALE STUDENT 3,0,0,0,,Sato-san!
Dialogue: 0,0:01:51.74,0:01:53.84,Flashback,MALE STUDENT 3,0,0,0,,Okuldan sonra bowlinge gitmek ister misin?
Dialogue: 0,0:01:53.84,0:01:55.33,Flashback,KOHARU,0,0,0,,Sağ ol, kalsın.
Dialogue: 0,0:01:56.12,0:01:57.28,Flashback,FEMALE STUDENT 2,0,0,0,,Sato-san!
Dialogue: 0,0:01:57.28,0:02:00.46,Flashback,FEMALE STUDENT 2,0,0,0,,Amigo kulübündenim de... \NKatılmak ister miydin acaba?
Dialogue: 0,0:02:00.46,0:02:01.88,Flashback,KOHARU,0,0,0,,İlgimi çekmiyor.
Dialogue: 0,0:02:02.67,0:02:04.50,Flashback,MALE STUDENT 4,0,0,0,,Sato-san! Beraber eve yürümek ister misin...
Dialogue: 0,0:02:04.50,0:02:06.32,Flashback,KOHARU,0,0,0,,Meşgulüm.
Dialogue: 0,0:02:07.57,0:02:11.46,Italics,SOTA,0,0,0,,Buz gibi sert tavırları kendisine yaklaşanları biraz zor durumda bırakıyor.
Dialogue: 0,0:02:12.56,0:02:14.36,Italics,SOTA,0,0,0,,Bana gelince...
Dialogue: 0,0:02:14.36,0:02:16.92,Italics,SOTA,0,0,0,,Bir keresinde selam vermeye \Nçalışmıştım ama...
Dialogue: 0,0:02:17.26,0:02:19.46,Flashback,SOTA,0,0,0,,Sato-san sensin... di' mi?
Dialogue: 0,0:02:19.46,0:02:20.64,Flashback,SOTA,0,0,0,,Sen de...
Dialogue: 0,0:02:20.64,0:02:22.80,Flashback,KOHARU,0,0,0,,Sen kimsin?
Dialogue: 0,0:02:23.88,0:02:24.70,Flashback,SOTA,0,0,0,,Ha?
Dialogue: 0,0:02:37.99,0:02:40.68,Italics,SOTA,0,0,0,,{\t(2044,3546,\1c&HFFFFFF&\3c&HFFFFFF&\4c&HFFFFFF&)}Onunla gireceğiniz çoğu etkileşim \Naz çok böyle olurdu.
Dialogue: 0,0:02:45.72,0:02:47.27,Italics,SOTA,0,0,0,,O yüzden bir lakap kazandı...
Dialogue: 0,0:02:59.56,0:03:03.05,Italics,SOTA,0,0,0,,Soğuk Sato-san.
Dialogue: 0,0:03:13.42,0:03:15.46,Default,SIGN,0,0,0,,{\an8\fnTimes New Roman\shad0\fs66\c&HC4C826&\bord0\b1\fad(482,140)}The {\c&H9657E9&}Cold Sato-san {\c&HC4C826&}is Only {\c&H9657E9&}Sweet {\c&HC4C826&}to {\c&H9657E9&}Me
Dialogue: 1,0:04:34.08,0:04:37.08,Default,SIGN,0,0,0,,{\fad(527,471)\fnArial\fs48\bord3\shad3\c&HBB91D7&\4c&HFFF5FF&\3c&HFFF5FF&\pos(450,828)}Bölüm 1
