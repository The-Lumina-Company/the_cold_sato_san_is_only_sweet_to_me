Dialogue: 0,0:02:07.33,0:02:09.05,Default,SHIZUKU,0,0,0,,Hadi ama, neşelen biraz!
Dialogue: 0,0:02:09.05,0:02:12.07,Default,SHIZUKU,0,0,0,,Yeter ama, toparlan artık!
Dialogue: 0,0:02:13.28,0:02:16.95,Default,SHIZUKU,0,0,0,,Öyle surat asıp oturursan\Nmutluluk seni nasıl bulsun!
Dialogue: 0,0:02:16.95,0:02:19.37,Default,SOTA,0,0,0,,Ne yapayım yani?
Dialogue: 0,0:02:19.37,0:02:21.82,Default,MAYO,0,0,0,,Shizuku, bence artık yeterince içtin.
Dialogue: 0,0:02:21.82,0:02:25.84,Default,SOTA,0,0,0,,Mayo giymek zorunda olmadığını\Nona defalarca söylemiştim oysa...
Dialogue: 0,0:02:26.20,0:02:28.83,Default,SOTA,0,0,0,,Derken bir anda...
Dialogue: 0,0:02:29.02,0:02:33.16,Default,SOTA,0,0,0,,Çıplak tenini... bir an için gördüm!
Dialogue: 0,0:02:34.36,0:02:36.61,Default,SHIZUKU,0,0,0,,Abartıyorsun!
Dialogue: 0,0:02:35.72,0:02:37.54,Default,MAYO,0,0,0,,Shizuku, bırak artık.
Dialogue: 0,0:02:37.54,0:02:39.34,Default,SHIZUKU,0,0,0,,"Çıplak ten" mi?
Dialogue: 0,0:02:39.34,0:02:40.84,Default,SOTA,0,0,0,,Gidip onu bulacağım.
Dialogue: 0,0:02:40.84,0:02:45.02,Default,SHIZUKU,0,0,0,,Ne?! Cidden mi?\NŞımartma onu böyle!
Dialogue: 0,0:02:45.61,0:02:46.49,Default,SOTA,0,0,0,,Ama...
Dialogue: 0,0:02:46.49,0:02:50.72,Default,SHIZUKU,0,0,0,,Aşırı korumacı babasını ikna\Neden sensin, değil mi?
Dialogue: 0,0:02:51.06,0:02:55.64,Default,SHIZUKU,0,0,0,,Şimdi gidip onu ararsan\Ntıpkı babası gibi davranmış olursun!
Dialogue: 0,0:02:55.64,0:02:58.36,Default,MAYO,0,0,0,,Birine bağımlı olmak\Nalışkanlığa dönüşebilir.
Dialogue: 0,0:02:59.02,0:03:00.11,Default,MAYO,0,0,0,,Merak etme.
Dialogue: 0,0:03:00.45,0:03:02.59,Default,MAYO,0,0,0,,Sakinleşince geri gelir.
Dialogue: 0,0:03:02.59,0:03:05.12,Default,MAYO,0,0,0,,Hem şimdi yanına gitsen bile,
Dialogue: 0,0:03:05.12,0:03:07.54,Default,MAYO,0,0,0,,Koharu-chan yine kaçar.
Dialogue: 0,0:03:08.45,0:03:11.29,Default,MAYO,0,0,0,,Şimdilik biraz yalnız bırak onu.
Dialogue: 0,0:03:11.29,0:03:12.95,Default,SOTA,0,0,0,,Haklısın...
Dialogue: 0,0:03:13.32,0:03:14.92,Default,SHIZUKU,0,0,0,,Aynen, aynen!
Dialogue: 0,0:03:15.47,0:03:18.76,Default,SOTA,0,0,0,,Mayo-san haklı olmalı.
Dialogue: 0,0:03:18.76,0:03:20.92,Default,SOTA,0,0,0,,Şu an yüzüne bakabileceğimi sanmıyorum.
Dialogue: 0,0:03:21.80,0:03:26.32,Default,SOTA,0,0,0,,Tenindeki o his aklımdan çıkmıyor...
Dialogue: 0,0:03:27.10,0:03:29.94,Default,SOTA,0,0,0,,Bu düşünceleri kafamdan atmalıyım!
Dialogue: 0,0:03:35.99,0:03:40.19,Default,RINKA,0,0,0,,Plaja kadar sırf böyle surat\Nasmak için mi geldin?
Dialogue: 0,0:03:40.62,0:03:43.59,Default,RINKA,0,0,0,,Çok yazık, Oshio-san!
Dialogue: 0,0:03:43.59,0:03:44.69,Default,SOTA,0,0,0,,Rinka-chan...
Dialogue: 0,0:03:44.69,0:03:45.65,Default,SOTA,0,0,0,,Hoppala!
Dialogue: 0,0:03:45.65,0:03:46.78,Default,SOTA,0,0,0,,B-B-Bir dakika!
Dialogue: 0,0:03:47.00,0:03:48.20,Default,SOTA,0,0,0,,Rinka-chan!
Dialogue: 0,0:03:53.60,0:03:56.23,Default,RINKA,0,0,0,,Lütfen bana da öğret!
Dialogue: 0,0:03:56.23,0:03:57.51,Default,RINKA,0,0,0,,Bana göster, nasıl...
Dialogue: 0,0:03:57.51,0:03:58.98,Default,RINKA,0,0,0,,...plajın tadı çıkarılır!
Dialogue: 0,0:04:00.71,0:04:02.47,Default,SOTA,0,0,0,,Rinka-chan...
Dialogue: 0,0:04:09.82,0:04:10.82,Default,MADOKA,0,0,0,,Hey!
Dialogue: 0,0:04:10.82,0:04:13.16,Default,MADOKA,0,0,0,,Burada tek başına n'apıyorsun?
Dialogue: 0,0:04:13.16,0:04:14.27,Default,KOHARU,0,0,0,,Madoka-chan...
Dialogue: 0,0:04:14.61,0:04:15.80,Default,KOHARU,0,0,0,,Çalışmıyor musun?
Dialogue: 0,0:04:15.80,0:04:17.22,Default,MADOKA,0,0,0,,Moladayım.
Dialogue: 0,0:04:17.22,0:04:19.53,Default,MADOKA,0,0,0,,Gözlem terasındaydım da...
Dialogue: 0,0:04:19.53,0:04:22.98,Default,MADOKA,0,0,0,,Plajın en iyi manzarası\Noradan görünür, bilirsin.
Dialogue: 0,0:04:22.98,0:04:24.88,Default,KOHARU,0,0,0,,Yani... her şeyi gördün mü?
Dialogue: 0,0:04:24.88,0:04:26.41,Default,MADOKA,0,0,0,,Hem de nasıl.
Dialogue: 0,0:04:26.66,0:04:28.34,Default,MADOKA,0,0,0,,Deli gibi koşuyordun.
Dialogue: 0,0:04:30.61,0:04:32.13,Default,MADOKA,0,0,0,,Al, bunu ye.
Dialogue: 0,0:04:32.13,0:04:33.41,Default,KOHARU,0,0,0,,Neyi?
Dialogue: 0,0:04:34.45,0:04:36.25,Default,KOHARU,0,0,0,,Yeşil... dondurma mı?
Dialogue: 0,0:04:36.25,0:04:38.43,Default,MADOKA,0,0,0,,Adı Midorikawa dondurması.
Dialogue: 0,0:04:38.43,0:04:40.66,Default,MADOKA,0,0,0,,Berbat bi' isim, değil mi?
Dialogue: 0,0:04:40.66,0:04:42.50,Default,MADOKA,0,0,0,,Kafemizin imza ürünü.
Dialogue: 0,0:04:42.50,0:04:43.71,Default,KOHARU,0,0,0,,Çok güzel görünüyor.
Dialogue: 0,0:04:45.30,0:04:46.76,Default,KOHARU,0,0,0,,Hem tuzlu hem tatlı mı?
Dialogue: 0,0:04:46.96,0:04:49.62,Default,KOHARU,0,0,0,,Ne tuhaf bir tat ama çok lezzetli!
Dialogue: 0,0:04:49.62,0:04:51.48,Default,MADOKA,0,0,0,,İçinde tuz var.
Dialogue: 0,0:04:51.48,0:04:53.58,Default,MADOKA,0,0,0,,Midorikawa denizinin tuzu.
Dialogue: 0,0:04:53.58,0:04:54.48,Default,KOHARU,0,0,0,,Anladım...
Dialogue: 0,0:04:54.48,0:04:58.28,Default,KOHARU,0,0,0,,Oshio-kun'un bahsettiği\Ndondurma bu olabilir mi?
Dialogue: 0,0:04:59.21,0:05:02.19,Default,MADOKA,0,0,0,,Az önce Sota'yı düşünüyordun, değil mi?
Dialogue: 0,0:05:02.49,0:05:04.88,Default,KOHARU,0,0,0,,N-Nereden bildin?!
Dialogue: 0,0:05:04.88,0:05:06.74,Default,KOHARU,0,0,0,,Medyum musun, Madoka-chan?
Dialogue: 0,0:05:06.74,0:05:08.61,Default,MADOKA,0,0,0,,Çok belli oluyor.
Dialogue: 0,0:05:08.61,0:05:10.91,Default,MADOKA,0,0,0,,Hadi anlat, ne oldu?
Dialogue: 0,0:05:12.92,0:05:16.56,Default,KOHARU,0,0,0,,Oshio-kun beni gördü...
Dialogue: 0,0:05:16.56,0:05:20.12,Default,KOHARU,0,0,0,,...bu iş için özel olarak aldığım mayomla...
Dialogue: 0,0:05:20.40,0:05:24.41,Default,KOHARU,0,0,0,,Ama beni o hâlde görünce o \Nkadar utandım ki kaçıp gittim.
Dialogue: 0,0:05:24.41,0:05:26.22,Default,MADOKA,0,0,0,,Hiç mantıklı değil.
Dialogue: 0,0:05:26.66,0:05:28.30,Default,KOHARU,0,0,0,,Biliyorum ya.
Dialogue: 0,0:05:28.30,0:05:33.32,Default,KOHARU,0,0,0,,Oshio-kun beni plaja davet edince\Nçok mutlu olmuştum.
Dialogue: 0,0:05:33.72,0:05:37.32,Default,KOHARU,0,0,0,,Aynı yerleri görmek, aynı yemekleri yemek,
Dialogue: 0,0:05:37.59,0:05:41.46,Default,KOHARU,0,0,0,,aynı şeyleri yapmak, onunla birlikte\Nbir sürü şey yaşamak istiyorum.
Dialogue: 0,0:05:41.46,0:05:46.28,Default,KOHARU,0,0,0,,Plaja gidersek daha çok sevgili\Ngibi olabiliriz diye düşünmüştüm.
Dialogue: 0,0:05:47.09,0:05:48.16,Default,KOHARU,0,0,0,,Ama...
Dialogue: 0,0:05:48.38,0:05:51.20,Default,KOHARU,0,0,0,,O şansı kendi ellerimle kaçırdım.
Dialogue: 0,0:05:51.20,0:05:53.58,Default,KOHARU,0,0,0,,Tam bir beceriksizim.
Dialogue: 0,0:05:53.58,0:05:56.16,Default,MADOKA,0,0,0,,Evet, hem de nasıl. Rezilin tekisin.
Dialogue: 0,0:05:56.16,0:05:58.87,Default,MADOKA,0,0,0,,İnanamıyorum. Ayıp sana.
Dialogue: 0,0:05:59.79,0:06:01.12,Default,MADOKA,0,0,0,,Ne? Bu surat ne böyle?
Dialogue: 0,0:06:01.12,0:06:03.99,Default,MADOKA,0,0,0,,Seni teselli edeceğimi mi sandın?
Dialogue: 0,0:06:03.99,0:06:07.51,Default,KOHARU,0,0,0,,Açıkçası biraz öyle bekliyordum.
Dialogue: 0,0:06:07.76,0:06:11.37,Default,KOHARU,0,0,0,,Yarama tuz basacağını hiç\Nbeklemiyordum.
Dialogue: 0,0:06:11.37,0:06:13.17,Default,MADOKA,0,0,0,,Ne yapayım, kusura bakma.
Dialogue: 0,0:06:13.17,0:06:17.83,Default,MADOKA,0,0,0,,Kadınların birbirine dert yanıp\Nüzülmesine dayanamıyorum.
Dialogue: 0,0:06:17.83,0:06:19.85,Default,MADOKA,0,0,0,,İstersen devam edebilirim.
Dialogue: 0,0:06:19.85,0:06:20.40,Default,MADOKA,0,0,0,,Berbatsın!
Dialogue: 0,0:06:20.40,0:06:22.07,Default,MADOKA,0,0,0,,Koharu, tam bir zavallısın!
Dialogue: 0,0:06:22.07,0:06:24.38,Default,MADOKA,0,0,0,,Bu işte suç yüzde yüz sende.
Dialogue: 0,0:06:24.38,0:06:25.73,Default,MADOKA,0,0,0,,Teselliyi hak etmiyorsun!
Dialogue: 0,0:06:26.26,0:06:27.68,Default,MADOKA,0,0,0,,Dinle.
Dialogue: 0,0:06:28.15,0:06:30.54,Default,MADOKA,0,0,0,,Paylaşmak isteyen tek kişi sen değilsin.
Dialogue: 0,0:06:30.54,0:06:33.26,Default,MADOKA,0,0,0,,Hoşlandığı biriyle bir şeyler, hani işte...
Dialogue: 0,0:06:34.16,0:06:36.68,Default,MADOKA,0,0,0,,Sota da aynı şeyi hissediyor.
Dialogue: 0,0:06:36.68,0:06:39.37,Default,MADOKA,0,0,0,,Karşılıklı hislerin olması\Nişte böyle bir şey, değil mi?\N
Dialogue: 0,0:06:39.37,0:06:41.37,Default,KOHARU,0,0,0,,Oshio-kun da mı aynı şeyi hissediyor?
Dialogue: 0,0:06:42.87,0:06:44.92,Default,MADOKA,0,0,0,,O yüzden kaçma ondan!
Dialogue: 0,0:06:44.92,0:06:48.16,Default,MADOKA,0,0,0,,Mayonla görünmekten çok utanıyorsan,\Nhavlu giy yeter!
Dialogue: 0,0:06:48.16,0:06:50.42,Default,MADOKA,0,0,0,,Onun yüzüne bakamıyorsan,\Nyüzünü sakla yeter!
Dialogue: 0,0:06:50.42,0:06:52.92,Default,MADOKA,0,0,0,,Eğer bir şey söyleyemiyorsan, \Nöylece sessiz kal yeter!
Dialogue: 0,0:06:52.92,0:06:55.80,Default,MADOKA,0,0,0,,Ne olursa olsun, bununla yüzleş.
Dialogue: 0,0:06:55.80,0:06:58.68,Default,MADOKA,0,0,0,,Onun yanında olduğun sürece\Nhislerin er ya da geç ona ulaşır.
Dialogue: 0,0:06:59.45,0:07:00.93,Italics,KOHARU,0,0,0,,Madoka-chan…
Dialogue: 0,0:07:03.03,0:07:05.40,Default,MADOKA,0,0,0,,Bana böyle utandırıcı şeyler\Nsöyletmene inanamıyorum.
Dialogue: 0,0:07:05.67,0:07:07.13,Default,KOHARU,0,0,0,,Madoka-chan…
Dialogue: 0,0:07:07.13,0:07:08.56,Default,MADOKA,0,0,0,,Ah, doğru.
Dialogue: 0,0:07:09.03,0:07:11.57,Default,MADOKA,0,0,0,,Al. Bunu da sana vereyim bari.
Dialogue: 0,0:07:11.57,0:07:12.75,Default,KOHARU,0,0,0,,Kilit mi?
Dialogue: 0,0:07:12.76,0:07:14.20,Default,MADOKA,0,0,0,,Bu bir asma kilit.
Dialogue: 0,0:07:14.48,0:07:18.44,Default,MADOKA,0,0,0,,Bunun üzerine ikinizin adını yazıp\Ngözlem terasının parmaklığına asarsanız,
Dialogue: 0,0:07:18.44,0:07:20.71,Default,MADOKA,0,0,0,,sonsuza dek birlikte olacağınız söyleniyor.
Dialogue: 0,0:07:20.71,0:07:22.58,Default,MADOKA,0,0,0,,Bilirsin, aşk zırvalıkları...
Dialogue: 0,0:07:22.58,0:07:25.20,Default,MADOKA,0,0,0,,Sen de böyle masalsı şeylere \Nbayılırsın, değil mi, Koharu?
Dialogue: 0,0:07:25.67,0:07:27.20,Default,KOHARU,0,0,0,,Neden…
Dialogue: 0,0:07:27.20,0:07:29.85,Default,KOHARU,0,0,0,,Neden benim için bunca şey yapıyorsun?
Dialogue: 0,0:07:29.85,0:07:32.70,Default,KOHARU,0,0,0,,Daha yeni tanıştık…
Dialogue: 0,0:07:33.25,0:07:35.60,Default,MADOKA,0,0,0,,Şey... Hımm...
Dialogue: 0,0:07:35.60,0:07:39.48,Default,MADOKA,0,0,0,,Aşk hayatlarımız hakkında konuştuğumuza göre\Nartık arkadaş sayılmaz mıyız?
Dialogue: 0,0:07:44.11,0:07:44.95,Default,MADOKA,0,0,0,,Ananı-
Dialogue: 0,0:07:44.95,0:07:48.90,Default,MADOKA,0,0,0,,Ne yapıyorsun? Çok soğuk!\NÜzerime dondurma bulaştırdın!
Dialogue: 0,0:07:47.52,0:07:52.48,Default Top,KOHARU,0,0,0,,Madoka-chan! Çok ama çok teşekkür ederim!
Dialogue: 0,0:07:48.90,0:07:51.21,Default,MADOKA,0,0,0,,Dur! Biraz uzaklaş!
Dialogue: 0,0:07:51.21,0:07:52.48,Default,MADOKA,0,0,0,,Dondum lan!
Dialogue: 0,0:07:52.48,0:07:54.48,Default,MADOKA,0,0,0,,Hadi! Bırak!
Dialogue: 0,0:07:54.48,0:07:55.37,Default,MADOKA,0,0,0,,Dinliyor musun?
Dialogue: 0,0:07:56.07,0:07:58.05,Italics,KOHARU,0,0,0,,Nasıl unutabilirdim ki?\N
Dialogue: 0,0:07:58.83,0:08:01.68,Italics,KOHARU,0,0,0,,Ben utanırsam,\NOshio-kun da utanır.
Dialogue: 0,0:08:02.12,0:08:05.12,Italics,KOHARU,0,0,0,,Ben eğleniyorsam, o da eğlenir.
Dialogue: 0,0:08:07.58,0:08:09.24,Italics,KOHARU,0,0,0,,Oshio-kun'u görmek istiyorum!
Dialogue: 0,0:08:10.80,0:08:12.66,Italics,KOHARU,0,0,0,,Birlikte denizi izlemek istiyorum.
Dialogue: 0,0:08:12.66,0:08:15.17,Italics,KOHARU,0,0,0,,Birlikte yeşil dondurma yemek istiyorum.
Dialogue: 0,0:08:15.17,0:08:18.09,Italics,KOHARU,0,0,0,,Birlikte aşk dolu anlar yaşamak istiyorum!
Dialogue: 0,0:08:18.09,0:08:22.56,Italics,KOHARU,0,0,0,,Ve harika arkadaşımla\Ngurur duymak istiyorum!
Dialogue: 0,0:08:28.53,0:08:30.69,Italics,KOHARU,0,0,0,,Bu fazlasıyla utanç vericiydi…
Dialogue: 0,0:08:30.69,0:08:31.90,Default,COLLEGE STUDENT A,0,0,0,,Hey, hanımefendi!
Dialogue: 0,0:08:31.90,0:08:32.52,Default,KOHARU,0,0,0,,Ah.
Dialogue: 0,0:08:32.52,0:08:33.97,Default,COLLEGE STUDENT A,0,0,0,,İyi misiniz?
Dialogue: 0,0:08:34.69,0:08:37.91,Default,COLLEGE STUDENT A,0,0,0,,Tam önümüze düştün.
Dialogue: 0,0:08:37.91,0:08:40.33,Default,COLLEGE STUDENT A,0,0,0,,İyi olup olmadığını sorayım dedim.
Dialogue: 0,0:08:40.73,0:08:43.59,Default,COLLEGE STUDENT A,0,0,0,,Ne o? Acelen falan mı var?
Dialogue: 0,0:08:43.59,0:08:45.98,Italics,KOHARU,0,0,0,,Alkol kokuyor…
Dialogue: 0,0:08:46.42,0:08:49.68,Default,KOHARU,0,0,0,,T-Teşekkür ederim, hâlimi sorduğunuz için...
Dialogue: 0,0:08:49.68,0:08:51.93,Default,KOHARU,0,0,0,,Üzgünüm, şimdi gitmem gerekiyor.
Dialogue: 0,0:08:51.93,0:08:54.55,Default,COLLEGE STUDENT A,0,0,0,,Bir dakika, sen şu…
Dialogue: 0,0:08:54.55,0:08:57.39,Default,COLLEGE STUDENT A,0,0,0,,Pankek kız! Bayağıdır görüşmedik!
Dialogue: 0,0:08:56.71,0:08:58.02,Default Top,COLLEGE STUDENT C,0,0,0,,Cidden mi? İnanılmaz!
Dialogue: 0,0:09:02.94,0:09:04.69,Default,COLLEGE STUDENT B,0,0,0,,Hadi canım! Ne tesadüf ama!
Dialogue: 0,0:09:04.69,0:09:06.12,Default,COLLEGE STUDENT C,0,0,0,,Yalnız mı geldin?
Dialogue: 0,0:09:06.12,0:09:07.93,Default,COLLEGE STUDENT C,0,0,0,,Birinin sana asılmasını mı bekliyordun?
Dialogue: 0,0:09:08.20,0:09:13.19,Italics,KOHARU,0,0,0,,Hayır... Hayır demek istiyorum ama... \Nyapamam...
Dialogue: 0,0:09:13.19,0:09:16.56,Default Top,COLLEGE STUDENT C,0,0,0,,Tam zamanında.\Nİçeceklerimiz şurada.
Dialogue: 0,0:09:13.76,0:09:17.44,Italics,KOHARU,0,0,0,,Korkuyorum... Korkuyorum... \NHayır... hayır!
Dialogue: 0,0:09:16.56,0:09:17.45,Default Top,COLLEGE STUDENT B,0,0,0,,Hadi gidelim.
Dialogue: 0,0:09:17.59,0:09:19.48,Italics,KOHARU,0,0,0,,Korkuyorum… Hayır…
Dialogue: 0,0:09:19.48,0:09:22.28,Italics,KOHARU,0,0,0,,Korkuyorum… Korkuyorum… Korkuyorum…
Dialogue: 0,0:09:22.80,0:09:24.24,Italics,KOHARU,0,0,0,,Biri yardım etsin!
Dialogue: 0,0:09:24.24,0:09:26.04,Default,SOTA,0,0,0,,Lütfen ona sataşmayı bırakın.
Dialogue: 0,0:09:30.93,0:09:33.66,Default,KOHARU,0,0,0,,Oshio-kun…?
Dialogue: 0,0:09:43.76,0:09:45.08,Default,MAYO,0,0,0,,Rinka-chan.
Dialogue: 0,0:09:45.72,0:09:47.54,Default,MAYO,0,0,0,,Rahatsız olmadın mı?
Dialogue: 0,0:09:48.84,0:09:52.73,Default,RINKA,0,0,0,,Biri seni bu kadar açıkça reddedince\Nne yapabilirsin ki?
Dialogue: 0,0:09:52.98,0:09:55.87,Flashback Italics,SOTA,0,0,0,,Yine de gidip Sato-san'ı arayacağım.
Dialogue: 0,0:09:56.97,0:10:01.68,Default,RINKA,0,0,0,,Koharu orada olmamasına rağmen,\NOshio-san'ın aklındaki tek şey oydu.
Dialogue: 0,0:10:02.75,0:10:05.24,Default,RINKA,0,0,0,,Artık gerçekten sinirlenmeye başladım.
Dialogue: 0,0:10:05.24,0:10:07.20,Default,RINKA,0,0,0,,Sahile kadar gelmişken...
Dialogue: 0,0:10:07.20,0:10:11.06,Default,RINKA,0,0,0,,...erkeklere asılmayı denesem \Nfena olmaz, değil mi?
Dialogue: 0,0:10:12.17,0:10:14.86,Default,MAYO,0,0,0,,Başına güneş geçecek, Rinka-chan.
Dialogue: 0,0:10:15.13,0:10:17.45,Default,MAYO,0,0,0,,Çok güzel bir cildin var, biliyor musun?
Dialogue: 0,0:10:19.81,0:10:22.40,Default,RINKA,0,0,0,,Her zaman içimi hemen okuyorsun,\NMayo-san.
Dialogue: 0,0:10:22.95,0:10:25.84,Default,RINKA,0,0,0,,Oshio-san'a karşı hislerim var.
Dialogue: 0,0:10:25.84,0:10:28.08,Default,RINKA,0,0,0,,Az önce yalan söyledim.
Dialogue: 0,0:10:28.08,0:10:30.94,Default,RINKA,0,0,0,,Oshio-san'ı gerçekten seviyorum.
Dialogue: 0,0:10:30.94,0:10:33.98,Default,RINKA,0,0,0,,Benimle hiç ilgilenmese bile...
Dialogue: 0,0:10:33.98,0:10:36.98,Default,MAYO,0,0,0,,Rinka-chan, ağlamıyorsun, değil mi?
Dialogue: 0,0:10:37.27,0:10:39.40,Default,RINKA,0,0,0,,Ağlamak mı? Asla.
Dialogue: 0,0:10:39.40,0:10:43.75,Default,RINKA,0,0,0,,Ağlarsam,\Nbu yenilgimi kabul etmek gibi olur.\N
Dialogue: 0,0:10:44.00,0:10:46.37,Default,RINKA,0,0,0,,Hatta, vazgeçmek yerine…
Dialogue: 0,0:10:46.68,0:10:49.90,Default,RINKA,0,0,0,,Bir dahaki sefere Oshio-san'a\Nduygularımı itiraf edeceğim!
Dialogue: 0,0:10:51.25,0:10:53.20,Default,COLLEGE STUDENT A,0,0,0,,Hey, bu sensin!
Dialogue: 0,0:10:53.20,0:10:55.59,Default,COLLEGE STUDENT A,0,0,0,,Geçen seferki garson!
Dialogue: 0,0:10:56.21,0:10:57.61,Default,COLLEGE STUDENT C,0,0,0,,Evet, seni hatırlıyorum!
Dialogue: 0,0:10:57.61,0:11:00.05,Default,COLLEGE STUDENT A,0,0,0,,Burada herhangi bir kısıtlama yok,
Dialogue: 0,0:11:00.05,0:11:02.24,Default,COLLEGE STUDENT A,0,0,0,,bize ne yapacağımızı söyleme hakkınız yok!
Dialogue: 0,0:11:02.24,0:11:03.20,Default,COLLEGE STUDENT A,0,0,0,,Tamam mı?
Dialogue: 0,0:11:04.22,0:11:06.97,Default,SOTA,0,0,0,,Bu hakka sahibim.
Dialogue: 0,0:11:08.50,0:11:09.86,Default,SOTA,0,0,0,,O benim sevgilim.
Dialogue: 0,0:11:11.67,0:11:12.87,Default,KOHARU,0,0,0,,O…
Dialogue: 0,0:11:14.56,0:11:16.81,Default,KOHARU,0,0,0,,Oshio-kun…
Dialogue: 0,0:11:19.85,0:11:21.95,Default,COLLEGE STUDENT A,0,0,0,,Ne havalısın be, yarı zamanlı çalışan!
Dialogue: 0,0:11:24.57,0:11:27.57,Default,COLLEGE STUDENT A,0,0,0,,Dostum… Tam bir baş belasısın.
Dialogue: 0,0:11:31.12,0:11:33.16,Default,REN,0,0,0,,Dur!
Dialogue: 0,0:11:33.16,0:11:34.26,Default,REN,0,0,0,,Hey…
Dialogue: 0,0:11:34.26,0:11:36.75,Default,REN,0,0,0,,Hey, hey, hey, hey!
Dialogue: 0,0:11:36.75,0:11:37.88,Default,REN,0,0,0,,Hey!
Dialogue: 0,0:11:37.88,0:11:40.63,Default,REN,0,0,0,,Sota-kun, sen misin?
Dialogue: 0,0:11:43.92,0:11:46.67,Default,REN,0,0,0,,Çok uzun zaman oldu, dostum!
Dialogue: 0,0:11:47.40,0:11:50.40,Default,REN,0,0,0,,Konuşma. Sadece oyuna ayak uydur.
Dialogue: 0,0:11:52.06,0:11:53.92,Default,REN,0,0,0,,Tesadüfe bak be.
Dialogue: 0,0:11:53.92,0:11:56.23,Default,REN,0,0,0,,Ben de arkadaşlarla geldim.
Dialogue: 0,0:11:56.23,0:11:58.28,Default,REN,0,0,0,,Hazır denk gelmişken\Nberaber takılırız.
Dialogue: 0,0:11:58.28,0:12:00.32,Default,REN,0,0,0,,Nasıl? Güzel olur di'mi?
Dialogue: 0,0:12:00.77,0:12:01.79,Default,REN,0,0,0,,Ha?
Dialogue: 0,0:12:02.59,0:12:05.44,Default,REN,0,0,0,,Ne bakıyorsunuz?
Dialogue: 0,0:12:05.72,0:12:06.59,Default,COLLEGE STUDENT A,0,0,0,,Ne?
Dialogue: 0,0:12:07.16,0:12:09.29,Default,COLLEGE STUDENT A,0,0,0,,Sen kimsin lan?
Dialogue: 0,0:12:09.49,0:12:10.49,Italics,SOTA,0,0,0,,Ren!
Dialogue: 0,0:12:14.95,0:12:16.52,Default,COLLEGE STUDENT A,0,0,0,,Ah!
Dialogue: 0,0:12:18.88,0:12:20.04,Default,KOHARU,0,0,0,,Leo!
Dialogue: 0,0:12:22.71,0:12:23.89,Default Top,COLLEGE STUDENT A,0,0,0,,Acıdı…
Dialogue: 0,0:12:22.71,0:12:23.90,Default,SOTA,0,0,0,,Leo!
Dialogue: 0,0:12:23.89,0:12:24.91,Default,COLLEGE STUDENT C,0,0,0,,İyi misin?
Dialogue: 0,0:12:24.89,0:12:26.44,Default,COLLEGE STUDENT A,0,0,0,,Ulan o kedi…
Dialogue: 0,0:12:26.46,0:12:27.22,Default,COLLEGE STUDENT B,0,0,0,,Ne?
Dialogue: 0,0:12:27.40,0:12:28.08,Default,SOTA,0,0,0,,Ha?
Dialogue: 0,0:12:28.39,0:12:29.72,Default,COLLEGE STUDENT A,0,0,0,,N'oluyor?
Dialogue: 0,0:12:28.39,0:12:29.72,Default Top,COLLEGE STUDENT B,0,0,0,,B-Bir problem var gibi…
Dialogue: 0,0:12:30.27,0:12:31.74,Default,MADOKA,0,0,0,,Hey!
Dialogue: 0,0:12:31.74,0:12:34.79,Default,MADOKA,0,0,0,,N'apıyorsunuz siz benim Leo'ma?!
Dialogue: 0,0:12:34.79,0:12:37.52,Default,MADOKA,0,0,0,,Gerizekalılar!
Dialogue: 0,0:12:48.10,0:12:50.84,Default,MADOKA,0,0,0,,Kaçacaksanız hiç başlamayın bile!
Dialogue: 0,0:12:48.11,0:12:51.66,Default Top,COLLEGE STUDENT A,0,0,0,,Öldürecek bizi!
Dialogue: 0,0:12:51.66,0:12:53.66,Default,MADOKA,0,0,0,,Hey, Koharu. İyi misin?
Dialogue: 0,0:12:54.24,0:12:55.67,Default,KOHARU,0,0,0,,Madoka-chan…
Dialogue: 0,0:12:55.67,0:12:57.54,Default,MADOKA,0,0,0,,N'oldu?
Dialogue: 0,0:12:57.54,0:12:59.55,Default,MADOKA,0,0,0,,Sana bir şey olmadı, di'mi?
Dialogue: 0,0:13:00.27,0:13:01.51,Default,KOHARU,0,0,0,,Madoka-chan…
Dialogue: 0,0:13:01.88,0:13:03.17,Default,KOHARU,0,0,0,,Madoka-chan…
Dialogue: 0,0:13:03.17,0:13:05.51,Default,KOHARU,0,0,0,,O çocuklardan daha korkunçtun.
Dialogue: 0,0:13:05.51,0:13:06.21,Default,KOHARU,0,0,0,,Ay!
Dialogue: 0,0:13:06.64,0:13:09.09,Default,MADOKA,0,0,0,,Ama beklediğimden cesurmuşsun,\NSota. Şaşırttın bak.
Dialogue: 0,0:13:09.75,0:13:11.40,Default,SOTA,0,0,0,,Murasaki-san…
Dialogue: 0,0:13:13.09,0:13:14.90,Default,SOTA,0,0,0,,Çok teşekkür ederim.
Dialogue: 0,0:13:14.90,0:13:16.47,Default,SOTA,0,0,0,,Gerçekten ne yapacağımı bilemedim.
Dialogue: 0,0:13:16.47,0:13:19.48,Default,MADOKA,0,0,0,,Harbi mi? Ben de her şey\N kontrolün altında sanmıştım.
Dialogue: 0,0:13:19.96,0:13:21.33,Italics,KOHARU,0,0,0,,Şimdi anladım…
Dialogue: 0,0:13:21.33,0:13:23.98,Italics,KOHARU,0,0,0,,Oshio-kun da korkmuştu.
Dialogue: 0,0:13:24.25,0:13:26.48,Italics,KOHARU,0,0,0,,Ama sırf benim için...
Dialogue: 0,0:13:27.01,0:13:28.42,Italics,KOHARU,0,0,0,,Oshio-kun…
Dialogue: 0,0:13:29.95,0:13:30.62,Default,SOTA,0,0,0,,Ha?!
Dialogue: 0,0:13:30.62,0:13:33.07,Default,REN,0,0,0,,Bak, gördün mü, Sota?
Dialogue: 0,0:13:33.07,0:13:36.42,Default,REN,0,0,0,,O üniversiteli bebeler\Nbaşta çok sert davranmışlardı.
Dialogue: 0,0:13:36.42,0:13:37.42,Default,REN,0,0,0,,Ne kadar ezikler!
Dialogue: 0,0:13:37.76,0:13:39.79,Default,SOTA,0,0,0,,Birden iyi hissetmeye mi başladın?
Dialogue: 0,0:13:39.79,0:13:41.68,Default,REN,0,0,0,,Nasıl gülmeden durayım ki?
Dialogue: 0,0:13:41.68,0:13:45.44,Default,REN,0,0,0,,Madoka bile birden serseri olup çıktı!
Dialogue: 0,0:13:47.30,0:13:50.20,Default,SOTA,0,0,0,,Ren, siz Murasaki-san'la tanışıyor muydunuz?
Dialogue: 0,0:13:50.20,0:13:51.08,Default,REN,0,0,0,,Ah.
Dialogue: 0,0:13:51.80,0:13:53.57,Default,REN,0,0,0,,Ben gideyim artık.
Dialogue: 0,0:13:55.80,0:13:58.42,Default,MADOKA,0,0,0,,Unutmamışsın işte.
Dialogue: 0,0:13:59.83,0:14:01.55,Default,REN,0,0,0,,Tabii ki unutmadım.
Dialogue: 0,0:14:02.96,0:14:04.03,Default,REN,0,0,0,,Unutur muyum hiç?
Dialogue: 0,0:14:10.57,0:14:12.46,Default,KOHARU,0,0,0,,Senin adına çok sevindim, Madoka-chan.
Dialogue: 0,0:14:12.46,0:14:14.08,Default,MADOKA,0,0,0,,Sen sus, salak!
Dialogue: 0,0:14:13.48,0:14:14.08,Default Top,KOHARU,0,0,0,,Ay.
Dialogue: 0,0:14:14.49,0:14:16.21,Default,MADOKA,0,0,0,,Ben işe dönüyorum.
Dialogue: 0,0:14:19.62,0:14:20.40,Default,KOHARU,0,0,0,,E…
Dialogue: 0,0:14:19.62,0:14:20.97,Default Top,SOTA,0,0,0,,E… şey…
Dialogue: 0,0:14:21.73,0:14:23.36,Default,KOHARU,0,0,0,,Oshio-kun!
Dialogue: 0,0:14:21.73,0:14:23.36,Default Top,SOTA,0,0,0,,Sato-san!
Dialogue: 0,0:14:27.39,0:14:29.56,Default,SOTA,0,0,0,,Biz de diğerlerinin yanına dönelim mi artık?
Dialogue: 0,0:14:30.10,0:14:31.12,Default,KOHARU,0,0,0,,Evet!
Dialogue: 0,0:14:31.93,0:14:33.89,Default,SIGN,0,0,0,,{\bord0\fax-0.26\shad0\b1\fs90\fnTimes New Roman\c&HC7C1B7&\3c&HECEDEA&\frz15.78\frx2\fry354\move(885.999,951,885.999,357.999,0,1943)}Kanami {\fs72\c&HC3BAAD&}Gu{\c&HA99F8D&}estho{\c&H7C6C53&}use
Dialogue: 0,0:14:34.95,0:14:38.03,Default,SHIZUKU,0,0,0,,Yüzmeden sonra soğuk\Nbira harika geliyor!
Dialogue: 0,0:14:38.03,0:14:39.86,Default,MAYO,0,0,0,,Shizuku, sen zaten her içtiğinde
Dialogue: 0,0:14:39.86,0:14:42.40,Default,MAYO,0,0,0,,"harika" diye bağırıyorsun.
Dialogue: 0,0:14:42.40,0:14:44.36,Default,SHIZUKU,0,0,0,,Sen hiç içmiyorsun sanki, Mayo.
Dialogue: 0,0:14:44.80,0:14:47.87,Default,SOTA,0,0,0,,Buraya son gelişimiz.
Dialogue: 0,0:14:48.65,0:14:51.50,Default,SOTA,0,0,0,,Kanami teyze bu yıl burayı kapatıyor.
Dialogue: 0,0:14:51.50,0:14:52.86,Default,KOHARU,0,0,0,,Gerçekten mi?
Dialogue: 0,0:14:52.86,0:14:56.32,Default,SHIZUKU,0,0,0,,Ne?! Daha çok deniz salyangosu yiyecektim!
Dialogue: 0,0:14:56.32,0:14:58.56,Default,KANAMI,0,0,0,,Ha? Ne konuşuyorsunuz siz bakayım?
Dialogue: 0,0:15:00.87,0:15:03.30,Default,KANAMI,0,0,0,,Kim demiş burayı kapatıyorum diye?
Dialogue: 0,0:15:03.62,0:15:05.62,Default,KANAMI,0,0,0,,Sadece biraz tadilat yaptırıyordum.
Dialogue: 0,0:15:05.62,0:15:06.76,Default,SOTA,0,0,0,,Tadilat?
Dialogue: 0,0:15:07.24,0:15:09.76,Italics,SOTA,0,0,0,,Ulan o kaz kafa.
Dialogue: 0,0:15:10.20,0:15:13.52,Default,KANAMI,0,0,0,,Sosyal medyada çok viral oldu. Bakın!
Dialogue: 0,0:15:13.51,0:15:20.06,Default,SIGN,0,0,0,,{\bord0\fs48\b1\fnArial\shad0\c&H92BCDD&\move(690,954,690,-36,0,5908)\frz346.5}Günün Yemeği
Dialogue: 0,0:15:13.51,0:15:20.46,Default,SIGN,0,0,0,,{\bord0\fs48\b1\fnArial\shad0\c&H92BCDD&\frz346.5\move(1464,1152,1464,-24,0,6950)}Günün Yemeği
Dialogue: 0,0:15:13.51,0:15:20.64,Default,SIGN,0,0,0,,{\bord0.75\fs24\b1\fnArial\shad0\c&H75B1DD&\3c&H82AECB&\frz337.4\move(576.003,1231.002,576.003,33.999,27,7118)\fscx111\fscy157}Tavsiye Ediliyor
Dialogue: 1,0:15:14.48,0:15:16.76,Default,RINKA,0,0,0,,Bu sizin Minsta'nız mı, Kanami-san?
Dialogue: 0,0:15:16.76,0:15:18.11,Default,MAYO,0,0,0,,Ne kadar şık.
Dialogue: 0,0:15:18.11,0:15:19.07,Default,KANAMI,0,0,0,,Evet.
Dialogue: 0,0:15:18.73,0:15:20.64,Default,SIGN,0,0,0,,{\bord0.75\fs24\b1\fnArial\shad0\c&H75B1DD&\3c&H82AECB&\frz352.3\fscx98\fscy142\move(1148.004,1107.999,1148.003,858,62,1732)}Kısık Ateşte Pişirilmiş\NDeniz Salyangozları
Dialogue: 1,0:15:19.07,0:15:24.58,Default,KANAMI,0,0,0,,Hatta burayı city pop çalan bir\Nkafeye çevirmeyi planlıyorum.
Dialogue: 0,0:15:24.58,0:15:25.60,Default,SHIZUKU,0,0,0,,Oo.
Dialogue: 0,0:15:25.60,0:15:26.77,Default,MAYO,0,0,0,,Ne güzel.
Dialogue: 0,0:15:26.77,0:15:28.77,Default,RINKA,0,0,0,,Başka neleriniz var?
Dialogue: 0,0:15:28.77,0:15:30.54,Default Top,MAYO,0,0,0,,Ben de merak ettim.
Dialogue: 0,0:15:29.06,0:15:30.53,Overlap Top,SHIZUKU,0,0,0,,Çok güzel duruyor!
Dialogue: 0,0:15:29.59,0:15:30.91,Default,KOHARU,0,0,0,,Oshio-kun.
Dialogue: 0,0:15:30.91,0:15:31.63,Default,SOTA,0,0,0,,Efendim?
Dialogue: 0,0:15:31.63,0:15:33.06,Default,KOHARU,0,0,0,,Eee…
Dialogue: 0,0:15:33.06,0:15:37.09,Default,KOHARU,0,0,0,,Buradan seni götürmek\Nistediğim bir yer var da…
Dialogue: 0,0:15:37.09,0:15:37.89,Default,SOTA,0,0,0,,Ne?
Dialogue: 0,0:15:40.08,0:15:42.29,Default,SOTA,0,0,0,,Bugün çok eğlenceliydi.
Dialogue: 0,0:15:42.29,0:15:43.96,Default,KOHARU,0,0,0,,Evet.
Dialogue: 0,0:15:43.96,0:15:46.20,Default,KOHARU,0,0,0,,İlk defa karpuz kırma oyunu oynadım.
Dialogue: 0,0:15:46.20,0:15:46.80,Default,SOTA,0,0,0,,Ben de.
Dialogue: 0,0:15:48.09,0:15:50.70,Flashback Top,SOTA,0,0,0,,{\i1}Hey! N'apıyorsunuz?!{\i0}
Dialogue: 0,0:15:47.34,0:15:51.63,Default,SOTA,0,0,0,,Gerçi Shizuku-san sarhoş olup karpuzla\Nkaçmaya çalışınca biraz korkmuştum.
Dialogue: 0,0:15:52.69,0:15:54.85,Default,KOHARU,0,0,0,,Rinka-chan da beni çok şaşırttı.
Dialogue: 0,0:15:54.85,0:15:56.84,Default,KOHARU,0,0,0,,Tam bir yüzme ustası!
Dialogue: 0,0:15:56.84,0:15:57.97,Default,SOTA,0,0,0,,Evet.
Dialogue: 0,0:15:57.97,0:16:00.22,Default,SOTA,0,0,0,,Mayo-san da harikaydı doğrusu.
Dialogue: 0,0:16:00.44,0:16:03.24,Default,SOTA,0,0,0,,Hiç bu kadar kocaman\Nbir kumdan kale görmemiştim.
Dialogue: 0,0:16:03.24,0:16:05.72,Default,KOHARU,0,0,0,,O kadar çok fotoğraf çektim ki!
Dialogue: 0,0:16:05.72,0:16:09.03,Default,KOHARU,0,0,0,,Bir de üstüne ilk arkadaşımı edindim.
Dialogue: 0,0:16:09.03,0:16:11.57,Default,KOHARU,0,0,0,,Bayağı şirin ve havalı bir kız.
Dialogue: 0,0:16:11.87,0:16:13.43,Default,SOTA,0,0,0,,Murasaki-san'dan mı bahsediyorsun?
Dialogue: 0,0:16:13.43,0:16:15.70,Default,SOTA,0,0,0,,İlk başta biraz afalladım doğrusu.
Dialogue: 0,0:16:15.70,0:16:17.46,Default,KOHARU,0,0,0,,Ben de.
Dialogue: 0,0:16:17.46,0:16:19.89,Default,KOHARU,0,0,0,,Herkesle aram biraz daha ısındı sanki.
Dialogue: 0,0:16:19.89,0:16:21.00,Default,KOHARU,0,0,0,,Oshio-kun…
Dialogue: 0,0:16:21.92,0:16:25.07,Default,KOHARU,0,0,0,,Beni denize çağırdığın için teşekkür ederim.
Dialogue: 0,0:16:38.26,0:16:39.92,Default,KOHARU,0,0,0,,Çok iyi…
Dialogue: 0,0:16:42.97,0:16:45.14,Default,KOHARU,0,0,0,,Hayatımda hiç böyle bir şey görmemiştim.
Dialogue: 0,0:16:45.14,0:16:48.69,Default,SOTA,0,0,0,,Buradan gün batımı manzarası\Nbambaşka bir şeymiş ya.
Dialogue: 0,0:16:49.43,0:16:51.08,Default,KOHARU,0,0,0,,Hiç gitmek istemiyorum…
Dialogue: 0,0:16:51.08,0:16:55.20,Default,KOHARU,0,0,0,,Her şey, batan güneş bile,\Nöylece kalsın isterdim.
Dialogue: 0,0:16:55.20,0:16:57.93,Default,KOHARU,0,0,0,,Eskiden olsa böyle dilerdim.
Dialogue: 0,0:16:58.58,0:17:00.69,Default,SOTA,0,0,0,,Şimdi öyle hissetmiyor musun?
Dialogue: 0,0:17:00.93,0:17:04.20,Default,KOHARU,0,0,0,,Hiç öyle hissetmiyorum desem yalan olur ama…
Dialogue: 0,0:17:04.51,0:17:08.52,Default,KOHARU,0,0,0,,Seninle daha çok güzellikler\Ngörmek istiyorum, Oshio-kun.
Dialogue: 0,0:17:08.52,0:17:10.35,Default,KOHARU,0,0,0,,Birlikte daha çok yemek yiyelim…
Dialogue: 0,0:17:10.35,0:17:12.00,Default,KOHARU,0,0,0,,Daha çok şey yapalım…
Dialogue: 0,0:17:12.46,0:17:13.40,Default,KOHARU,0,0,0,,Ve…
Dialogue: 0,0:17:13.40,0:17:16.47,Default,KOHARU,0,0,0,,Bunları benimle yaşarken senin de\Nmutlu olmanı istiyorum, Oshio-kun.
Dialogue: 0,0:17:16.47,0:17:18.28,Default,KOHARU,0,0,0,,İçimden geçenler bunlar.
Dialogue: 0,0:17:18.28,0:17:19.48,Default,SOTA,0,0,0,,Sato-san…
Dialogue: 0,0:17:19.76,0:17:21.19,Default,KOHARU,0,0,0,,İşte bu yüzden…
Dialogue: 0,0:17:21.19,0:17:24.97,Default,KOHARU,0,0,0,,Artık her yeni günü\Niple çekiyorum galiba…
Dialogue: 0,0:17:26.56,0:17:27.63,Default,KOHARU,0,0,0,,Al!
Dialogue: 0,0:17:27.63,0:17:29.24,Default,KOHARU,0,0,0,,Bunu Madoka-chan verdi.
Dialogue: 0,0:17:30.20,0:17:32.18,Default,SOTA,0,0,0,,Bu…
Dialogue: 0,0:17:32.18,0:17:34.95,Default,SOTA,0,0,0,,Bir aşk kilidi, değil mi?
Dialogue: 0,0:17:34.95,0:17:35.75,Default,KOHARU,0,0,0,,Evet!
Dialogue: 0,0:17:36.17,0:17:41.53,Default,KOHARU,0,0,0,,Bundan sonra da birlikte nice\Ngüzel anılar biriktirebilmek için, Oshio-kun…
Dialogue: 0,0:17:41.84,0:17:43.95,Default,KOHARU,0,0,0,,Bu kilidi birlikte asalım mı?
Dialogue: 0,0:17:43.95,0:17:45.84,Default,SOTA,0,0,0,,T-Tabii ki!
Dialogue: 0,0:17:45.84,0:17:48.12,Default,SOTA,0,0,0,,Ben de tam olarak bunu istiyorum!
Dialogue: 0,0:17:48.12,0:17:49.09,Default,KOHARU,0,0,0,,Çok sevindim!
Dialogue: 0,0:17:52.87,0:17:53.88,Default,SOTA,0,0,0,,İşte oldu.
Dialogue: 0,0:17:55.36,0:17:57.84,Default,SOTA,0,0,0,,Seninle daha çok vakit geçirmek için\Nsabırsızlanıyorum.
Dialogue: 0,0:17:57.84,0:17:59.96,Default,KOHARU,0,0,0,,Ben de, Oshi…
Dialogue: 0,0:18:01.51,0:18:03.52,Default,SIGN,0,0,0,,{\fs15\t(0,2010,\fs17)\bord0\fnComic Sans MS\b1\shad0\c&H090611&\move(268,230,260.667,238,0,1989)}Koharu
Dialogue: 0,0:18:01.51,0:18:03.52,Default,SIGN,0,0,0,,{\fs15\t(0,2010,\fs17)\bord0\fnGeorgia\shad0\c&H090611&\frz333.9\move(384.667,248,392.666,258,28,1989)}Sota
Dialogue: 0,0:18:01.71,0:18:02.84,Default,KOHARU,0,0,0,,Yani…
Dialogue: 0,0:18:03.52,0:18:06.11,Default,KOHARU,0,0,0,,Sota-kun…
Dialogue: 0,0:18:13.02,0:18:16.40,Italics,KOHARU,0,0,0,,Yoksa ona adıyla seslenmek için\Nçok mu erkendi?
Dialogue: 0,0:18:16.72,0:18:18.65,Italics,KOHARU,0,0,0,,K-Kızdı mı yoksa?
Dialogue: 0,0:18:18.65,0:18:20.57,Default,KOHARU,0,0,0,,O-Oshio-kun…
Dialogue: 0,0:18:20.57,0:18:22.90,Default,KOHARU,0,0,0,,Tuhaf bir şey mi söyledim?
Dialogue: 0,0:18:24.24,0:18:25.63,Default,KOHARU,0,0,0,,Neden kaçıyorsun?
Dialogue: 0,0:18:25.63,0:18:26.50,Default,KOHARU,0,0,0,,Oshio-kun!
Dialogue: 0,0:18:43.66,0:18:49.30,Default,SHIZUKU,0,0,0,,Flaş haber! Koharu Sato, Sota Oshio'yu\Nyere devirdi! Şok, şok, şok!
Dialogue: 0,0:18:49.68,0:18:50.55,Default,SOTA,0,0,0,,Shizuku-san!
Dialogue: 0,0:18:50.55,0:18:52.20,Default,KOHARU,0,0,0,,Mayo-san ve Rinka-chan, siz de mi?!
Dialogue: 0,0:18:52.20,0:18:54.67,Default,SHIZUKU,0,0,0,,İkinize de bir ömür mutluluklar!
Dialogue: 0,0:18:54.67,0:18:56.15,Default,MAYO,0,0,0,,Kusura bakmayın, çocuklar.
Dialogue: 0,0:18:56.15,0:18:58.40,Default,RINKA,0,0,0,,Ben de pes etmeyeceğim!
Dialogue: 0,0:19:09.38,0:19:11.23,Default,SOTA,0,0,0,,Bir dahakine yalnız ikimiz geliriz.
Dialogue: 0,0:19:11.23,0:19:12.12,Default,KOHARU,0,0,0,,Olur!
Dialogue: 0,0:19:11.23,0:19:12.12,Default,KOHARU,0,0,0,,{\an7\fscx75\fscy75}ÇN: Kapanıştan sonra sahne var. Kapatmayın.
Dialogue: 0,0:20:59.48,0:21:01.14,Flashback,KOHARU,0,0,0,,Söz ver! Bana söz vermelisin!
Dialogue: 0,0:21:01.14,0:21:03.49,Flashback,KOHARU,0,0,0,,Beni ziyarete geleceksin, tamam mı?! Lütfen!
Dialogue: 0,0:21:04.47,0:21:06.32,Default,MADOKA,0,0,0,,Pestilim çıktı.
Dialogue: 0,0:21:07.00,0:21:09.76,Default,MADOKA,0,0,0,,Ama bayağı eğlendik, değil mi?
Dialogue: 0,0:21:10.40,0:21:13.54,Default,MADOKA,0,0,0,,Leo, sen de çok yorulmuşsundur.
Dialogue: 0,0:21:14.91,0:21:17.52,Default,MADOKA,0,0,0,,Hey, nereye gidiyorsun?
Dialogue: 0,0:21:17.52,0:21:20.00,Default,MADOKA,0,0,0,,Hadi eve gidelim! Alo!
Dialogue: 0,0:21:24.90,0:21:27.09,Default,MADOKA,0,0,0,,Yapma gözünü seveyim ya.
Dialogue: 0,0:21:27.09,0:21:29.44,Default,MADOKA,0,0,0,,Sana söyledim, ben…
Dialogue: 0,0:21:39.16,0:21:40.62,Italics,MADOKA,0,0,0,,Ren?!
Dialogue: 0,0:21:45.27,0:21:46.24,Default,MADOKA,0,0,0,,Re…
Dialogue: 0,0:21:47.15,0:21:48.36,Italics,MADOKA,0,0,0,,Hayır…
Dialogue: 0,0:21:48.36,0:21:51.40,Italics,MADOKA,0,0,0,,Konuşacak bir şeyimiz yok.\NHepsi geçmişte kaldı.
Dialogue: 0,0:21:51.40,0:21:52.91,Flashback Italics,KOHARU,0,0,0,,Ama daha bitmedi!
Dialogue: 0,0:21:55.03,0:21:56.91,Flashback,KOHARU,0,0,0,,Bana sen demiştin!
Dialogue: 0,0:21:57.16,0:22:00.21,Flashback,KOHARU,0,0,0,,"Yerinde sayarsan hislerin\Npişmanlığa dönüşür!" diye.
Dialogue: 0,0:22:05.54,0:22:06.76,Default,MADOKA,0,0,0,,Ren!
Dialogue: 0,0:22:08.21,0:22:11.40,Default,MADOKA,0,0,0,,N'apıyorsun burada?
Dialogue: 0,0:22:13.52,0:22:16.00,Default,MADOKA,0,0,0,,Bir sonraki trene yetişemeyeceksin.
Dialogue: 0,0:22:17.73,0:22:20.02,Default,SIGN,0,0,0,,{\an7\fnComic Sans MS\shad0\c&H274755&\3c&H4486A2&}Ren
Dialogue: 0,0:22:17.73,0:22:20.02,Default,SIGN,0,0,0,,{\an9\fnComic Sans MS\b1\shad0\c&H144359&\3c&H468AA1&}Madoka
Dialogue: 0,0:22:18.04,0:22:20.02,Default,REN,0,0,0,,Yıllar önce taktığımız şu…
Dialogue: 0,0:22:20.47,0:22:25.88,Default,REN,0,0,0,,utanç verici kilidi açmaya gelmiştim ama…
Dialogue: 0,0:22:26.33,0:22:27.04,Default,REN,0,0,0,,Tut!
Dialogue: 0,0:22:32.37,0:22:33.66,Default,MADOKA,0,0,0,,Anahtar?
Dialogue: 0,0:22:47.52,0:22:51.18,Default,REN,0,0,0,,Öyle paslanmış ki anahtar\Ndeliğe bile girmiyor.
Dialogue: 0,0:22:56.48,0:22:58.90,Default,MADOKA,0,0,0,,Denizden esen rüzgâr yüzünden.
Dialogue: 0,0:23:00.38,0:23:02.48,Default,REN,0,0,0,,Deniz kenarı da tam bir bela.
Dialogue: 0,0:23:02.48,0:23:04.16,Default,MADOKA,0,0,0,,Sorma.
Dialogue: 0,0:23:04.32,0:23:07.30,Default,MADOKA,0,0,0,,Sonraki tren de\Nbir buçuk saat sonra gelecek.
Dialogue: 0,0:23:07.30,0:23:10.66,Default,REN,0,0,0,,Ciddi misin? Burası da hiç çekilmiyor.
Dialogue: 0,0:23:10.66,0:23:12.50,Default,MADOKA,0,0,0,,Ee, ne yapacaksın peki?
Dialogue: 0,0:23:12.50,0:23:14.08,Default,REN,0,0,0,,Madem öyle…
Dialogue: 0,0:23:14.78,0:23:19.38,Default,REN,0,0,0,,Biraz takılıp hasret giderelim mi?
Dialogue: 0,0:23:19.75,0:23:21.55,Default,MADOKA,0,0,0,,Peki, olur.
Dialogue: 0,0:23:22.16,0:23:23.92,Default,MADOKA,0,0,0,,Biraz vakit ayırabilirim.
Dialogue: 0,0:23:25.12,0:23:26.47,Default,REN,0,0,0,,Sağ ol.
Dialogue: 0,0:23:26.80,0:23:30.72,Default,SIGN,0,0,0,,{\fs30\t(0,3920,\fs20)\blur0.5\fnComic Sans MS\b0\bord0\shad0\fad(1273,729)\c&H598189&\frx8\fry0\move(248.333,272,344.666,223.333,272,3567)}Madoka
Dialogue: 0,0:23:26.80,0:23:30.72,Default,SIGN,0,0,0,,{\fs30\t(0,3920,\fs20)\blur0.5\fnComic Sans MS\b1\bord0\shad0\fad(1273,729)\c&H4F5776&\frx8\fry0\move(420.667,278.667,446,225.333,397,3817)}Ren
Dialogue: 0,0:23:29.97,0:23:34.60,Default,SIGN,0,0,0,,{\blur0.5\bord0\shad0\fs40\fad(814,0)\t(0,4630,\fs30)\c&H6C6165&\t(3984,4651,\c&H000000&)\fnComic Sans MS\b1\frz17.73\frx4\fry6\move(178,257.333,196.667,240.667,0,4609)}Ko{\c&H7B686D&\t(3984,4651,\c&H000000&)}haru
