Dialogue: 0,0:00:05.28,0:00:07.07,Default,STATION WORKER,0,0,0,,Tren kalkıyor.
Dialogue: 0,0:00:10.19,0:00:11.72,Italics,SOTA,0,0,0,,Öff…
Dialogue: 0,0:00:11.72,0:00:13.90,Italics,SOTA,0,0,0,,Buluşmamıza daha iki saat var.
Dialogue: 0,0:00:14.19,0:00:17.32,Italics,SOTA,0,0,0,,Neden bu kadar erken geldim ki sanki?
Dialogue: 0,0:00:27.27,0:00:28.20,Default,SOTA,0,0,0,,Yoksa bu…
Dialogue: 0,0:00:35.95,0:00:37.72,Default,SOTA,0,0,0,,Sato-san…?
Dialogue: 0,0:00:44.38,0:00:45.66,Default,SOTA,0,0,0,,Biliyordum.
Dialogue: 0,0:00:46.02,0:00:47.74,Default,KOHARU,0,0,0,,Oshio-kun!
Dialogue: 0,0:00:59.49,0:01:01.49,Default,SIGN,0,0,0,,{\an8\fnTimes New Roman\shad0\fs30\c&HC4C826&\bord0\b1\fad(482,140)\fscx175\fscy175}{\c&H9657E9&}Soğuk Sato-san, {\c&HC4C826&}Sadece {\c&H9657E9&}Bana Karşı {\c&HC4C826&}Tatlı {\c&H9657E9&}
Dialogue: 1,0:02:20.16,0:02:24.16,Default,SIGN,0,0,0,,{\fad(527,471)\fnArial\fs72\bord3\shad3\c&H3CAB77&\4c&HFFF5FF&\3c&HF5F5F5&\pos(312,816)}Bölüm 6
Dialogue: 0,0:02:20.16,0:02:24.16,Default,SIGN,0,0,0,,{\fad(527,471)\p1\bord0\an8\shad0\c&HF463EC&\frz359.9\fscx84\fscy6\pos(310.5,819)}m 0 0 l 230 0 l 230 215 l 0 215
Dialogue: 1,0:02:20.16,0:02:24.16,Default,SIGN,0,0,0,,{\fad(527,471)\fnArial\fs72\bord3\shad3\c&H3CAB77&\4c&HFFF5FF&\3c&HF5F5F5&\pos(498,1044)}Deniz, Bir Kedi ve Aşk Muhabbeti
Dialogue: 0,0:02:20.16,0:02:24.16,Default,SIGN,0,0,0,,{\fad(527,471)\p1\bord0\an8\shad0\c&HF463EC&\frz359.9\fscx339\fscy6\pos(505.5,1047)}m 0 0 l 230 0 l 230 215 l 0 215
Dialogue: 0,0:02:22.53,0:02:24.16,Default Top,SOTA,0,0,0,,Bayağı erken gelmişsin.
Dialogue: 0,0:02:24.16,0:02:25.29,Default,KOHARU,0,0,0,,Şey...
Dialogue: 0,0:02:25.97,0:02:28.35,Default,KOHARU,0,0,0,,Diğerlerinin beni beklemesini istemedim.
Dialogue: 0,0:02:28.81,0:02:30.54,Default,SOTA,0,0,0,,Ne tesadüf, ben de.
Dialogue: 0,0:02:38.56,0:02:39.52,Default,KOHARU,0,0,0,,Kediymiş.
Dialogue: 0,0:02:40.20,0:02:41.96,Default,SOTA,0,0,0,,Doğru, burada bir sürü var.
Dialogue: 0,0:02:41.96,0:02:43.52,Default,KOHARU,0,0,0,,Ç-Çok tatlı!
Dialogue: 0,0:02:46.60,0:02:48.01,Default,KOHARU,0,0,0,,Selam, kedicik!
Dialogue: 0,0:02:52.10,0:02:52.84,Default,KOHARU,0,0,0,,Ha?
Dialogue: 0,0:02:53.48,0:02:55.32,Default,KOHARU,0,0,0,,Y-Ya, dursana!
Dialogue: 0,0:02:58.32,0:03:02.33,Italics,SOTA,0,0,0,,Bizim buz gibi Sato-san \Nekilmeyi tadıyor demek.
Dialogue: 0,0:03:02.55,0:03:05.29,Default,SOTA,0,0,0,,En azından bir fotoğrafını\Nfalan çekebilirdin belki?
Dialogue: 0,0:03:05.50,0:03:07.29,Default,KOHARU,0,0,0,,Oshio-kun, tam bir dahisin!
Dialogue: 0,0:03:07.60,0:03:09.88,Default,KOHARU,0,0,0,,Kımıldama, sakın kımıldama…
Dialogue: 0,0:03:18.03,0:03:19.95,Default,SOTA,0,0,0,,Genelde öyle olur zaten.
Dialogue: 0,0:03:19.95,0:03:21.80,Default,SOTA,0,0,0,,Hayvan fotoğrafı çekmek zordur.
Dialogue: 0,0:03:22.03,0:03:25.13,Default,KOHARU,0,0,0,,Ama sen benden çok daha iyisindir, Oshio-kun!
Dialogue: 0,0:03:25.13,0:03:27.49,Default,SOTA,0,0,0,,Yani, evet, tabii ki öyle de…
Dialogue: 0,0:03:29.36,0:03:32.10,Default,SOTA,0,0,0,,S-Sana kedi fotoğrafı çekmeyi\Nöğretebilirim!
Dialogue: 0,0:03:32.10,0:03:33.11,Default,KOHARU,0,0,0,,Cidden mi?
Dialogue: 0,0:03:33.11,0:03:35.04,Default,SOTA,0,0,0,,Şimdiden söyleyeyim de...
Dialogue: 0,0:03:36.30,0:03:38.36,Default,SOTA,0,0,0,,Pek bir bilgim yok aslında.
Dialogue: 0,0:03:38.36,0:03:39.82,Default,SOTA,0,0,0,,Bir bakayım şöyle.
Dialogue: 0,0:03:41.00,0:03:43.60,Default,KOHARU,0,0,0,,O-Oshio-kun?
Dialogue: 0,0:03:43.60,0:03:46.45,Default,SOTA,0,0,0,,Aynı ekrana bakmak daha kolay, değil mi?
Dialogue: 0,0:03:46.45,0:03:49.24,Default,SOTA,0,0,0,,Bir dakika, dejavu oluyorum sanki.
Dialogue: 0,0:03:49.24,0:03:51.29,Default,KOHARU,0,0,0,,E-Evet…
Dialogue: 0,0:03:51.29,0:03:52.91,Default,SOTA,0,0,0,,Tamam, önce...
Dialogue: 0,0:03:52.91,0:03:53.62,Default,SOTA,0,0,0,,Ha?
Dialogue: 0,0:03:53.62,0:03:54.62,Default,KOHARU,0,0,0,,Kulaklarım...
Dialogue: 0,0:03:54.62,0:03:58.13,Default,KOHARU,0,0,0,,Sesini hemen kulağımın dibinde\Nduyuyorum... Bir de...
Dialogue: 0,0:03:58.13,0:03:59.80,Default,SOTA,0,0,0,,Ö-Özür dilerim!
Dialogue: 0,0:03:59.80,0:04:01.55,Italics,SOTA,0,0,0,,Pis düşünceler, defolun!\NPis düşünceler, defolun!
Dialogue: 0,0:04:01.55,0:04:03.04,Italics,SOTA,0,0,0,,Pis düşünceler, defolun!
Dialogue: 0,0:04:03.64,0:04:05.15,Default,SOTA,0,0,0,,Ş-Şey...
Dialogue: 0,0:04:05.15,0:04:09.44,Default,SOTA,0,0,0,,Flaşı kapatıp kamerayı\Nkedinin göz hizasında tut...
Dialogue: 0,0:04:09.44,0:04:12.01,Default,KOHARU,0,0,0,,Pisi pisi! Buraya bak!
Dialogue: 0,0:04:12.01,0:04:15.37,Italics,SOTA,0,0,0,,Fotoğrafı çekene kadar\Nböyle mi duracağım yani...?
Dialogue: 0,0:04:15.37,0:04:17.16,Italics,SOTA,0,0,0,,Yok artık, bu kadarı da fazla!
Dialogue: 0,0:04:17.16,0:04:18.49,Default,SOTA,0,0,0,,Sato-san.
Dialogue: 0,0:04:18.49,0:04:20.43,Default,SOTA,0,0,0,,Fotoğrafı sen çekeceksin.
Dialogue: 0,0:04:20.43,0:04:21.15,Default,KOHARU,0,0,0,,Ne?
Dialogue: 0,0:04:26.37,0:04:28.12,Default,SOTA,0,0,0,,Sato-san, şimdi çek!
Dialogue: 0,0:04:30.12,0:04:32.38,Default,SOTA,0,0,0,,S-Sato-san?
Dialogue: 0,0:04:32.88,0:04:35.08,Default,KOHARU,0,0,0,,Bir daha... yap...
Dialogue: 0,0:04:35.33,0:04:36.34,Default,SOTA,0,0,0,,Ne?!
Dialogue: 0,0:04:36.65,0:04:39.33,Default,KOHARU,0,0,0,,A-Az önce yaptığını bir daha yap!
Dialogue: 0,0:04:40.01,0:04:42.03,Default,SOTA,0,0,0,,N-Niye kediden daha çok\Nsen heyecanlandın ki?!
Dialogue: 0,0:04:42.03,0:04:44.00,Default,KOHARU,0,0,0,,Hadi ama, lütfen!
Dialogue: 0,0:04:44.00,0:04:44.95,Default,KOHARU,0,0,0,,Bir kere daha!
Dialogue: 0,0:04:44.95,0:04:46.94,Default,SOTA,0,0,0,,Hey, fazla yaklaştın.
Dialogue: 0,0:04:46.94,0:04:49.22,Default,KOHARU,0,0,0,,Bu kez videoya çekeceğim,\Nbir kere daha yapsana!
Dialogue: 0,0:04:49.22,0:04:51.31,Default,SOTA,0,0,0,,Dur, bir saniye!
Dialogue: 0,0:04:53.28,0:04:54.20,Default,SOTA,0,0,0,,Acıdı...
Dialogue: 0,0:04:54.20,0:04:56.18,Default,KOHARU,0,0,0,,Ahh...
Dialogue: 0,0:04:56.18,0:04:58.08,Default,SOTA,0,0,0,,İyi misin, Sato-san?
Dialogue: 0,0:04:58.08,0:04:59.44,Default,KOHARU,0,0,0,,E-Evet.
Dialogue: 0,0:05:00.49,0:05:02.17,Default,MADOKA,0,0,0,,Hey, siz...
Dialogue: 0,0:05:02.17,0:05:06.45,Default,MADOKA,0,0,0,,Benim kediye n'apıyonuz öyle?
Dialogue: 0,0:05:07.46,0:05:10.16,Italics,SOTA,0,0,0,,B-Bu kız tam bir serseri...!
Dialogue: 0,0:05:13.88,0:05:15.45,Default,MADOKA,0,0,0,,Bu Leo.
Dialogue: 0,0:05:15.45,0:05:18.12,Default,MADOKA,0,0,0,,Ben de Madoka Murasaki.
Dialogue: 0,0:05:18.12,0:05:19.80,Default,SOTA,0,0,0,,M-Merhaba.
Dialogue: 0,0:05:19.80,0:05:22.32,Italics,SOTA,0,0,0,,İyice içine kapandı.
Dialogue: 0,0:05:22.32,0:05:22.95,Default,MADOKA,0,0,0,,Eee?
Dialogue: 0,0:05:22.95,0:05:24.42,Default,SOTA,0,0,0,,E-Efendim?
Dialogue: 0,0:05:24.42,0:05:26.48,Default,MADOKA,0,0,0,,Sizin adınız ne?
Dialogue: 0,0:05:26.48,0:05:28.60,Default,MADOKA,0,0,0,,Biz kendimizi tanıttık sonuçta.
Dialogue: 0,0:05:29.51,0:05:31.32,Default,SOTA,0,0,0,,S-Sota!
Dialogue: 0,0:05:31.32,0:05:33.21,Default,SOTA,0,0,0,,Adım Sota Oshio.\NLise ikinci sınıfa gidiyorum.
Dialogue: 0,0:05:33.21,0:05:36.39,Default,MADOKA,0,0,0,,Aynı yaştaymışız! Peki ya sen?
Dialogue: 0,0:05:36.39,0:05:38.94,Default,MADOKA,0,0,0,,B-Ben Koharu...
Dialogue: 0,0:05:38.94,0:05:41.24,Default,MADOKA,0,0,0,,Ha?! Ne dedin sen?
Dialogue: 0,0:05:42.00,0:05:43.19,Default,KOHARU,0,0,0,,Ben Koharu!
Dialogue: 0,0:05:43.19,0:05:44.69,Default,KOHARU,0,0,0,,Koharu Sato!
Dialogue: 0,0:05:46.19,0:05:48.84,Default,SOTA,0,0,0,,Kusura bakma, biraz heyecanlı da.
Dialogue: 0,0:05:48.84,0:05:49.97,Default,MADOKA,0,0,0,,Anladım.
Dialogue: 0,0:05:49.97,0:05:52.72,Default,MADOKA,0,0,0,,Peki burada ne işiniz var? Denize mi geldiniz?
Dialogue: 0,0:05:52.72,0:05:55.32,Default,SOTA,0,0,0,,Pansiyon işleten bir akrabamı\Nziyarete geldim.
Dialogue: 0,0:05:55.32,0:05:56.70,Default,SOTA,0,0,0,,Adı da Kanami Pansiyonu.
Dialogue: 0,0:05:57.31,0:05:59.47,Default,MADOKA,0,0,0,,Sen Kana ninenin akrabası mısın?!
Dialogue: 0,0:05:59.47,0:06:02.10,Default,MADOKA,0,0,0,,En baştan söylesene onu!
Dialogue: 0,0:06:02.10,0:06:04.60,Default,SOTA,0,0,0,,Ah! Acıyor!
Dialogue: 0,0:06:04.88,0:06:06.93,Default,MADOKA,0,0,0,,O zaman hadi, gidelim!
Dialogue: 0,0:06:06.93,0:06:08.96,Default,MADOKA,0,0,0,,Kana nine çok sevinecek!
Dialogue: 0,0:06:08.96,0:06:10.17,Default,SOTA,0,0,0,,Hey!
Dialogue: 0,0:06:10.93,0:06:12.03,Default,KOHARU,0,0,0,,Ş-Şey!
Dialogue: 0,0:06:14.72,0:06:16.60,Default,KOHARU,0,0,0,,Sen... Sen var ya...
Dialogue: 0,0:06:16.60,0:06:18.79,Default,KOHARU,0,0,0,,Böyle yapamazsın!
Dialogue: 0,0:06:22.32,0:06:25.28,Default,MADOKA,0,0,0,,Sevgilin de amma komikmiş, Sota!
Dialogue: 0,0:06:25.28,0:06:26.33,Default,KOHARU,0,0,0,,Sevgili mi?!
Dialogue: 0,0:06:27.36,0:06:28.35,Default,MADOKA,0,0,0,,Hadi, gidelim.
Dialogue: 0,0:06:28.35,0:06:30.45,Default,MADOKA,0,0,0,,Saat onda işe gideceğim.
Dialogue: 0,0:06:30.45,0:06:31.45,Default,KOHARU,0,0,0,,Sevgili...
Dialogue: 0,0:06:33.64,0:06:35.87,Default,SOTA,0,0,0,,Hey! Sato-san?
Dialogue: 0,0:06:38.87,0:06:40.62,Default,SIGN,0,0,0,,{\fax-0.26\shad0\b1\fs60\pos(864,267)\fnTimes New Roman\c&HB8AF9C&\3c&HECEDEA&\frz19.33}Kanami {\fs58}Pansiyonu
Dialogue: 0,0:06:40.62,0:06:43.63,Default,SIGN,0,0,0,,{\shad0\b1\fs45\fnTimes New Roman\c&H8E806B&\3c&HE4E4E1&\pos(987,444)}Kanami {\fs45}Pansiyonu
Dialogue: 0,0:06:43.64,0:06:47.13,Default,SOTA,0,0,0,,Hiç değişmemiş.
Dialogue: 0,0:06:47.13,0:06:48.50,Default,MADOKA,0,0,0,,Hop!
Dialogue: 0,0:06:49.80,0:06:51.34,Default,SOTA,0,0,0,,H-Hey!
Dialogue: 0,0:06:51.34,0:06:54.71,Default,SOTA,0,0,0,,İnsan başkasının kapısını\Nöyle tekmeleyerek açar mı?!
Dialogue: 0,0:06:54.71,0:06:55.80,Default,MADOKA,0,0,0,,Aptal!
Dialogue: 0,0:06:55.80,0:06:59.16,Default,MADOKA,0,0,0,,Bu kapı sıkışıyor,\Nancak böyle açılıyor!
Dialogue: 0,0:07:02.36,0:07:04.15,Default,KANAMI,0,0,0,,Ne istiyorsunuz?
Dialogue: 0,0:07:04.15,0:07:07.14,Default,MADOKA,0,0,0,,Akrabanı getirdim sana.
Dialogue: 0,0:07:07.14,0:07:08.61,Default,SOTA,0,0,0,,Kanami nine!
Dialogue: 0,0:07:08.61,0:07:09.99,Default,SOTA,0,0,0,,Görüşmeyeli uzun zaman oldu!
Dialogue: 0,0:07:09.99,0:07:10.99,Default,SOTA,0,0,0,,Seni görmek çok güzel.
Dialogue: 0,0:07:15.56,0:07:17.57,Default,KANAMI,0,0,0,,Kaç yıldır söylüyorum sana!
Dialogue: 0,0:07:17.57,0:07:20.12,Default,KANAMI,0,0,0,,Ben senin ninen değilim,
Dialogue: 0,0:07:20.12,0:07:20.97,Default,KANAMI,0,0,0,,anladın mı?!
Dialogue: 0,0:07:24.60,0:07:25.89,Default,KANAMI,0,0,0,,Anlaşıldı mı?!
Dialogue: 0,0:07:25.89,0:07:28.52,Default,SOTA,0,0,0,,Evet... Kanami teyze.
Dialogue: 0,0:07:33.87,0:07:35.80,Default,KANAMI,0,0,0,,Demek Koharu-chan sensin, ha?
Dialogue: 0,0:07:35.80,0:07:37.95,Default,KOHARU,0,0,0,,E-Evet, benim.
Dialogue: 0,0:07:38.32,0:07:40.14,Default,KOHARU,0,0,0,,Ben Koharu.
Dialogue: 0,0:07:40.87,0:07:43.40,Default,KANAMI,0,0,0,,Kusura bakma. Korkuttum mu seni?
Dialogue: 0,0:07:44.61,0:07:48.42,Default,KANAMI,0,0,0,,Amanın! Oyuncak bebek gibi\Ntatlıymışsın sen!
Dialogue: 0,0:07:48.42,0:07:50.40,Default,KANAMI,0,0,0,,Hoş geldin, Koharu-chan.
Dialogue: 0,0:07:54.83,0:07:56.61,Default,KOHARU,0,0,0,,Bunlar salyangoz mu?
Dialogue: 0,0:07:56.61,0:07:58.61,Default,MADOKA,0,0,0,,Haşlanmış deniz salyangozu.
Dialogue: 0,0:08:00.52,0:08:02.84,Italics,KOHARU,0,0,0,,Oshio-kun, yardım et!
Dialogue: 0,0:08:02.84,0:08:06.63,Flashback,SOTA,0,0,0,,Kusura bakma! Kanami nineye yardım edeceğim.
Dialogue: 0,0:08:07.54,0:08:10.42,Default,MADOKA,0,0,0,,İstemiyor musun? Çok lezzetli ama.
Dialogue: 0,0:08:11.20,0:08:16.44,Default,KOHARU,0,0,0,,Şimdiye kadar sadece tatlı su\Nmidyesiyle kum midyesi yedim...
Dialogue: 0,0:08:16.44,0:08:19.73,Default,MADOKA,0,0,0,,Haa, nasıl yenildiğini\Nbilmiyorsun demek.
Dialogue: 0,0:08:19.73,0:08:20.39,Default,MADOKA,0,0,0,,O zaman...
Dialogue: 0,0:08:20.72,0:08:22.48,Default,MADOKA,0,0,0,,Beni izle de öğren.
Dialogue: 0,0:08:25.40,0:08:27.40,Default,MADOKA,0,0,0,,Hadi, şimdi sen dene.
Dialogue: 0,0:08:27.40,0:08:29.04,Default,KOHARU,0,0,0,,P-Peki.
Dialogue: 0,0:08:32.63,0:08:34.16,Default,MADOKA,0,0,0,,Sakar şey.
Dialogue: 0,0:08:34.16,0:08:36.07,Default,KOHARU,0,0,0,,Bayağı zormuş bu.
Dialogue: 0,0:08:41.86,0:08:44.84,Default,MADOKA,0,0,0,,Ee, siz ikiniz ne kadar ilerlediniz?
Dialogue: 0,0:08:44.84,0:08:46.13,Default,KOHARU,0,0,0,,Ne kadar mı?
Dialogue: 0,0:08:46.13,0:08:47.41,Default,MADOKA,0,0,0,,Hani şey...
Dialogue: 0,0:08:48.37,0:08:49.96,Default,MADOKA,0,0,0,,Sevgilinle diyorum.
Dialogue: 0,0:08:49.96,0:08:51.17,Default,MADOKA,0,0,0,,İlla söyletme bana!
Dialogue: 0,0:08:52.61,0:08:54.18,Default,KOHARU,0,0,0,,Ş-Şey...
Dialogue: 0,0:08:56.68,0:08:59.60,Default,KOHARU,0,0,0,,Oshio-kun'la öyle bir şeyimiz yok!
Dialogue: 0,0:08:59.60,0:09:02.36,Default,MADOKA,0,0,0,,Ne? Siz çıkmıyor musunuz?
Dialogue: 0,0:09:03.11,0:09:04.81,Default,KOHARU,0,0,0,,Çıkıyoruz ama...
Dialogue: 0,0:09:04.81,0:09:08.65,Default,KOHARU,0,0,0,,Y-Yani anlatacak\Npek bir şeyimiz yok.
Dialogue: 0,0:09:08.94,0:09:10.40,Default,MADOKA,0,0,0,,Anlatsana!
Dialogue: 0,0:09:11.75,0:09:13.11,Default,KOHARU,0,0,0,,Peki.
Dialogue: 0,0:09:16.86,0:09:19.91,Default,KOHARU,0,0,0,,Sonra ben de ona\Naçıldım işte...
Dialogue: 0,0:09:20.30,0:09:23.60,Default,KOHARU,0,0,0,,Ö-Özür dilerim. Çok sıkıcıydı, değil mi?
Dialogue: 0,0:09:23.60,0:09:26.25,Default,MADOKA,0,0,0,,"Öyle bir şeyimiz yok"muş! Hadi oradan!
Dialogue: 0,0:09:26.25,0:09:29.41,Default,MADOKA,0,0,0,,Birbirinize açılıp\Nresmen sevgili olmuşsunuz!
Dialogue: 0,0:09:29.41,0:09:33.77,Default,KOHARU,0,0,0,,Ama yani... Daha sevgililer gibi\Nbir şey yapmadık.
Dialogue: 0,0:09:33.77,0:09:34.29,Default,MADOKA,0,0,0,,Şey...
Dialogue: 0,0:09:34.60,0:09:39.30,Default,MADOKA,0,0,0,,Aranızdaki düzen bozulacak diye\Nkorkmanı anlıyorum.
Dialogue: 0,0:09:39.89,0:09:43.36,Default,MADOKA,0,0,0,,Ama isteseniz de istemeseniz de\Nbir şeyler değişecek.
Dialogue: 0,0:09:43.36,0:09:45.31,Default,MADOKA,0,0,0,,Öyle yerinizde sayarsanız,
Dialogue: 0,0:09:45.63,0:09:48.32,Default,MADOKA,0,0,0,,bu hisleriniz sonunda\Npişmanlığa dönüşür.
Dialogue: 0,0:09:48.56,0:09:50.27,Default,KOHARU,0,0,0,,Murasaki-san...
Dialogue: 0,0:09:51.16,0:09:53.64,Default,KOHARU,0,0,0,,Senin de hoşlandığın biri var mı?
Dialogue: 0,0:09:54.82,0:09:56.04,Default,MADOKA,0,0,0,,Ne?!
Dialogue: 0,0:09:56.04,0:09:56.69,Default,KOHARU,0,0,0,,Hey!
Dialogue: 0,0:09:56.69,0:09:58.95,Default,KOHARU,0,0,0,,Bu tepki her şeyi ele verdi!
Dialogue: 0,0:09:58.95,0:10:02.20,Default,KOHARU,0,0,0,,Aşk muhabbeti karşılıklı\Nolur, değil mi?
Dialogue: 0,0:10:02.70,0:10:06.70,Default,MADOKA,0,0,0,,Keşke ağzımı açmasaydım.
Dialogue: 0,0:10:07.35,0:10:09.46,Default,MADOKA,0,0,0,,Çok eskidendi.
Dialogue: 0,0:10:09.68,0:10:12.56,Default,MADOKA,0,0,0,,Daha Sakuraba'da yaşarken.
Dialogue: 0,0:10:12.56,0:10:15.20,Default,KOHARU,0,0,0,,Murasaki-san, sen Sakurabalı mısın?
Dialogue: 0,0:10:15.20,0:10:17.76,Default,MADOKA,0,0,0,,Ortaokula kadar orada yaşadım.
Dialogue: 0,0:10:17.76,0:10:21.62,Default,MADOKA,0,0,0,,Ama taşındığımdan beri\Nonu bir daha görmedim.
Dialogue: 0,0:10:21.62,0:10:26.75,Default,MADOKA,0,0,0,,Çocukluk arkadaşımdı,\Nhep birlikte takılırdık.
Dialogue: 0,0:10:26.75,0:10:29.00,Default,MADOKA,0,0,0,,Ama şimdi dönüp bakınca...
Dialogue: 0,0:10:30.52,0:10:32.36,Default,KOHARU,0,0,0,,İlk aşkınmış o senin!
Dialogue: 0,0:10:32.36,0:10:34.12,Default,MADOKA,0,0,0,,N-Ne?!
Dialogue: 0,0:10:34.37,0:10:35.90,Default,KOHARU,0,0,0,,Üstelik hâlâ hoşlanıyorsun!
Dialogue: 0,0:10:35.90,0:10:37.35,Default,MADOKA,0,0,0,,Yok artık!
Dialogue: 0,0:10:37.35,0:10:38.73,Default,KOHARU,0,0,0,,Emin misin?
Dialogue: 0,0:10:40.00,0:10:42.14,Default,MADOKA,0,0,0,,Üstüme gelme!
Dialogue: 0,0:10:40.36,0:10:41.33,Default Top,KOHARU,0,0,0,,Ah!
Dialogue: 0,0:10:42.88,0:10:45.95,Default,KOHARU,0,0,0,,Serseri olunca konuşmadan\Nönce elin kalkıyor tabii!
Dialogue: 0,0:10:45.95,0:10:48.04,Default,MADOKA,0,0,0,,Kime serseri diyorsun sen?!
Dialogue: 0,0:10:48.04,0:10:49.83,Default,KOHARU,0,0,0,,Ama tam bir serserisin!
Dialogue: 0,0:10:51.60,0:10:52.88,Default,REN,0,0,0,,Açılmıyor.
Dialogue: 0,0:10:53.95,0:10:56.67,Default,MAYO,0,0,0,,Birilerinden yardım istememiz gerekebilir.
Dialogue: 0,0:10:56.67,0:10:58.32,Default,RINKA,0,0,0,,Ben hallederim.
Dialogue: 0,0:10:58.32,0:10:59.68,Default,KOHARU,0,0,0,,Ş-Şey...
Dialogue: 0,0:10:59.68,0:11:01.91,Default,MADOKA,0,0,0,,Sahibi dışarıda!
Dialogue: 0,0:11:01.91,0:11:03.50,Default,MADOKA,0,0,0,,Yani...
Dialogue: 0,0:11:04.15,0:11:06.35,Default,MADOKA,0,0,0,,Daha açılmadık bile...
Dialogue: 0,0:11:20.54,0:11:21.78,Default,REN,0,0,0,,Ne bakıyo'n öyle?
Dialogue: 0,0:11:22.93,0:11:25.20,Default,MADOKA,0,0,0,,Hiç.
Dialogue: 0,0:11:28.24,0:11:30.04,Default,KOHARU,0,0,0,,Ha? Ne? Dur!
Dialogue: 0,0:11:30.42,0:11:31.50,Default,KOHARU,0,0,0,,H-Hey!
Dialogue: 0,0:11:31.50,0:11:34.16,Default,RINKA,0,0,0,,Bekle! Nereye gidiyorsun, Koharu?
Dialogue: 0,0:11:34.16,0:11:35.54,Default,RINKA,0,0,0,,Koharu!
Dialogue: 0,0:11:35.54,0:11:36.99,Default,SHIZUKU,0,0,0,,Ne oldu şimdi?
Dialogue: 0,0:11:51.64,0:11:53.24,Default,KOHARU,0,0,0,,Murasaki-san!
Dialogue: 0,0:11:53.24,0:11:56.40,Default,KOHARU,0,0,0,,Ş-Şey... Ren-kun'la\Naranızda bir şey mi oldu?
Dialogue: 0,0:11:56.69,0:11:59.41,Default,MADOKA,0,0,0,,Demek o gerçekten Ren'di...
Dialogue: 0,0:11:59.41,0:12:01.50,Default,MADOKA,0,0,0,,Burada ne işi var onun be?!
Dialogue: 0,0:12:01.50,0:12:03.66,Default,KOHARU,0,0,0,,B-Bahsettiğin kişi o mu?
Dialogue: 0,0:12:03.66,0:12:05.92,Default,KOHARU,0,0,0,,Eskiden hoşlandığın çocuk...
Dialogue: 0,0:12:05.92,0:12:08.16,Default,KOHARU,0,0,0,,Ren-kun mu yani?
Dialogue: 0,0:12:08.16,0:12:09.76,Default,MADOKA,0,0,0,,Sadece ilgimi çekiyordu, o kadar!
Dialogue: 0,0:12:09.76,0:12:11.67,Default,MADOKA,0,0,0,,Hem o zamanlar daha\Nilkokuldaydık, tamam mı?!
Dialogue: 0,0:12:11.97,0:12:14.58,Default,MADOKA,0,0,0,,Anladın mı?!
Dialogue: 0,0:12:14.58,0:12:15.92,Default,KOHARU,0,0,0,,A-Anladım!
Dialogue: 0,0:12:18.92,0:12:21.33,Default,KOHARU,0,0,0,,Sana Madoka-chan diyebilir miyim?
Dialogue: 0,0:12:21.33,0:12:22.42,Default,MADOKA,0,0,0,,Ne?!
Dialogue: 0,0:12:22.42,0:12:24.37,Default,KOHARU,0,0,0,,Madem aşk hayatımızdan\Nkonuştuk,
Dialogue: 0,0:12:24.37,0:12:26.17,Default,KOHARU,0,0,0,,artık sana adınla\Nhitap edebilirim diye düşündüm.
Dialogue: 0,0:12:26.17,0:12:29.36,Default,MADOKA,0,0,0,,İnsanlarla nasıl bu kadar\Nçabuk samimi oluyorsun sen?
Dialogue: 0,0:12:29.36,0:12:30.80,Default,MADOKA,0,0,0,,Hem zaten...
Dialogue: 0,0:12:32.26,0:12:34.68,Default,MADOKA,0,0,0,,O iş... çoktan bitti.
Dialogue: 0,0:12:35.37,0:12:36.93,Default,KOHARU,0,0,0,,Ama bitmedi ki.
Dialogue: 0,0:12:38.45,0:12:40.03,Default,KOHARU,0,0,0,,Hiç de bitmiş değil!
Dialogue: 0,0:12:40.03,0:12:43.61,Default,KOHARU,0,0,0,,Ren-kun'dan hâlâ hoşlandığın belli.
Dialogue: 0,0:12:43.61,0:12:45.62,Default,KOHARU,0,0,0,,O yüzden kaçıp gittin, değil mi?
Dialogue: 0,0:12:46.19,0:12:48.96,Default,KOHARU,0,0,0,,Onca zaman sonra eline fırsat geçmişken...
Dialogue: 0,0:12:48.96,0:12:50.77,Default,KOHARU,0,0,0,,Bunu sen söyledin.
Dialogue: 0,0:12:50.77,0:12:54.20,Default,KOHARU,0,0,0,,Yerinde sayarsan, hislerin\Npişmanlığa dönüşür dedin!
Dialogue: 0,0:12:54.20,0:12:55.71,Default,MADOKA,0,0,0,,İmkânsız.
Dialogue: 0,0:12:55.71,0:12:59.28,Default,MADOKA,0,0,0,,Beni hatırladığı bile yoktur.
Dialogue: 0,0:12:59.28,0:13:02.72,Default,MADOKA,0,0,0,,Hem şimdiki hâline bak, ne kadar yakışıklı!
Dialogue: 0,0:13:02.93,0:13:06.15,Default,MADOKA,0,0,0,,Neyin nesi bu, ünlü falan mı?!
Dialogue: 0,0:13:09.10,0:13:11.72,Default,KOHARU,0,0,0,,Her şey yoluna girer! Çok güzelsin, Madoka-chan!
Dialogue: 0,0:13:12.12,0:13:13.22,Default,MADOKA,0,0,0,,Hayır, değilim!
Dialogue: 0,0:13:13.52,0:13:16.20,Default,MADOKA,0,0,0,,Deniz rüzgârından saçım kaskatı kesildi,
Dialogue: 0,0:13:16.20,0:13:17.76,Default,MADOKA,0,0,0,,doğru düzgün makyaj bile yapmadım.
Dialogue: 0,0:13:17.76,0:13:19.68,Default,KOHARU,0,0,0,,Saç ürünlerimi ödünç veririm!
Dialogue: 0,0:13:19.68,0:13:21.11,Default,KOHARU,0,0,0,,Makyaj malzemelerimi de kullanabilirsin!
Dialogue: 0,0:13:21.11,0:13:23.64,Default,MADOKA,0,0,0,,B-Benim için neden\Nbu kadar uğraşıyorsun?
Dialogue: 0,0:13:23.64,0:13:24.88,Default,KOHARU,0,0,0,,Çünkü!
Dialogue: 0,0:13:30.20,0:13:31.88,Default,KOHARU,0,0,0,,Aşk hayatımızdan konuştuğumuza göre...
Dialogue: 0,0:13:31.88,0:13:33.17,Default,KOHARU,0,0,0,,artık arkadaşız, değil mi?
Dialogue: 0,0:13:37.28,0:13:38.88,Default,MADOKA,0,0,0,,Allah Allah...
Dialogue: 0,0:13:38.88,0:13:41.99,Default,MADOKA,0,0,0,,Beni düşünecek\Nzaman mı şimdi?
Dialogue: 0,0:13:41.22,0:13:41.99,Default Top,KOHARU,0,0,0,,Ah!
Dialogue: 0,0:13:41.99,0:13:44.82,Default,MADOKA,0,0,0,,Birine adıyla\Nhitap edeceksen,
Dialogue: 0,0:13:44.82,0:13:46.89,Default,MADOKA,0,0,0,,önce kendi\Nsevgiline etsen ya, Koharu?
Dialogue: 0,0:13:47.82,0:13:49.39,Default,KOHARU,0,0,0,,Sevgilime mi?!
Dialogue: 0,0:13:51.03,0:13:52.67,Default,KOHARU,0,0,0,,Hey, Madoka-chan?
Dialogue: 0,0:13:52.67,0:13:53.64,Default,MADOKA,0,0,0,,İşe gitmem lazım!
Dialogue: 0,0:13:58.54,0:13:59.78,Default,SOTA,0,0,0,,Sato-san.
Dialogue: 0,0:13:59.78,0:14:01.11,Default,KOHARU,0,0,0,,Oshio-kun.
Dialogue: 0,0:14:01.11,0:14:02.40,Default,SOTA,0,0,0,,Ne oldu?
Dialogue: 0,0:14:02.79,0:14:04.02,Default,KOHARU,0,0,0,,Oshio-kun...
Dialogue: 0,0:14:04.02,0:14:05.19,Default,KOHARU,0,0,0,,Galiba...
Dialogue: 0,0:14:05.19,0:14:08.15,Default,KOHARU,0,0,0,,Galiba ilk kez bir kızla arkadaş oldum!
Dialogue: 0,0:14:09.23,0:14:11.23,Default,SOTA,0,0,0,,Gerçekten mi? Harika!
Dialogue: 0,0:14:11.23,0:14:12.23,Default,KOHARU,0,0,0,,Evet!
Dialogue: 0,0:14:12.78,0:14:14.78,Default,SHIZUKU,0,0,0,,Kanami-san!
Dialogue: 0,0:14:14.78,0:14:16.25,Default,SHIZUKU,0,0,0,,Bir bira daha lütfen!
Dialogue: 0,0:14:16.25,0:14:18.80,Default,KANAMI,0,0,0,,Olur, 750 yen!
Dialogue: 0,0:14:18.80,0:14:20.53,Default,SHIZUKU,0,0,0,,Ne?! Resmen kazık bu!
Dialogue: 0,0:14:20.53,0:14:21.91,Default,SHIZUKU,0,0,0,,Para göz!
Dialogue: 0,0:14:21.91,0:14:23.05,Default,MAYO,0,0,0,,Shizuku.
Dialogue: 0,0:14:23.05,0:14:25.62,Default,KANAMI,0,0,0,,Turistik yer tarifesi, kızım.
Dialogue: 0,0:14:25.62,0:14:28.32,Default,KANAMI,0,0,0,,Rinka-chan, sana\Nbir ramune getireyim, olur mu?
Dialogue: 0,0:14:28.32,0:14:30.27,Default,RINKA,0,0,0,,Ç-Çok teşekkürler!
Dialogue: 0,0:14:30.27,0:14:33.46,Default,KANAMI,0,0,0,,Bol bol ye.\NBir deri bir kemik kalmışsın.
Dialogue: 0,0:14:33.46,0:14:35.05,Default,REN,0,0,0,,Aç bile değilim ki.
Dialogue: 0,0:14:36.52,0:14:38.57,Default,MAYO,0,0,0,,Aa, hoş geldiniz.
Dialogue: 0,0:14:38.57,0:14:41.44,Default,SHIZUKU,0,0,0,,Sota-kun! Gelsene buraya!
Dialogue: 0,0:14:42.03,0:14:44.68,Default,SHIZUKU,0,0,0,,Bana bir şeyler doldursana.
Dialogue: 0,0:14:44.68,0:14:46.68,Default,MAYO,0,0,0,,Shizuku, bu resmen yetkini kötüye kullanmak.
Dialogue: 0,0:14:47.96,0:14:49.76,Default,SOTA,0,0,0,,Canım deniz salyangozlarım!
Dialogue: 0,0:14:49.76,0:14:51.90,Default,SOTA,0,0,0,,O kadar canım çekmişti ki!
Dialogue: 0,0:14:51.90,0:14:54.12,Default,SHIZUKU,0,0,0,,Kusura bakma! Bir sürü yedim.
Dialogue: 0,0:14:55.20,0:14:57.59,Default,RINKA,0,0,0,,O kadar mı yemek istiyordun?
Dialogue: 0,0:14:57.59,0:14:58.41,Default,SOTA,0,0,0,,Ha?
Dialogue: 0,0:15:02.21,0:15:03.22,Default,KOHARU,0,0,0,,Ha?!
Dialogue: 0,0:15:06.04,0:15:09.05,Default,RINKA,0,0,0,,O-Oshio-san, "Aaa" de.
Dialogue: 0,0:15:09.97,0:15:14.60,Default,SOTA,0,0,0,,Ç-Çok sağ ol ama gerek yok.
Dialogue: 0,0:15:14.60,0:15:16.05,Default,SOTA,0,0,0,,Sen ye onu.
Dialogue: 0,0:15:16.05,0:15:18.56,Default,RINKA,0,0,0,,A-Ama en sevdiğin şey değil mi?
Dialogue: 0,0:15:18.56,0:15:21.36,Default,SOTA,0,0,0,,Y-Yani, evet...
Dialogue: 0,0:15:21.36,0:15:24.07,Default,SOTA,0,0,0,,İşte o yüzden senin\Nyemeni istiyorum, Rinka-chan.
Dialogue: 0,0:15:28.04,0:15:30.57,Default,RINKA,0,0,0,,Çok teşekkür ederim. O zaman...
Dialogue: 0,0:15:38.41,0:15:39.27,Default,SHIZUKU,0,0,0,,Tamamdır!
Dialogue: 0,0:15:39.27,0:15:41.74,Default,SHIZUKU,0,0,0,,Karnımızı doyurduk, enerji topladık!
Dialogue: 0,0:15:41.74,0:15:43.45,Default,SHIZUKU,0,0,0,,Hepimiz buradayız!
Dialogue: 0,0:15:43.45,0:15:45.50,Default,SHIZUKU,0,0,0,,Artık vakit geldi...
Dialogue: 0,0:15:45.50,0:15:47.76,Default,SHIZUKU,0,0,0,,Plaja hücum!
Dialogue: 0,0:15:56.22,0:15:58.79,Default,SOTA,0,0,0,,Hey Ren, yüzmeye gidelim mi?
Dialogue: 0,0:15:58.79,0:16:01.45,Default,REN,0,0,0,,Çok uğraştırıcı.\NYüzeceksen tek başına git.
Dialogue: 0,0:16:01.45,0:16:04.26,Default,REN,0,0,0,,Yalnız kalmaktan korkuyorsan\Nkızları bekle.
Dialogue: 0,0:16:04.26,0:16:06.00,Default,SOTA,0,0,0,,Z-Zaten o yüzden sana soruyorum!
Dialogue: 0,0:16:06.00,0:16:09.07,Default,SOTA,0,0,0,,Sato-san birazdan\Nmayosuyla çıkacak!
Dialogue: 0,0:16:09.07,0:16:11.24,Default,SOTA,0,0,0,,Dikkatimi dağıtmak için yüzmem lazım.
Dialogue: 0,0:16:11.24,0:16:12.64,Default,SOTA,0,0,0,,Yoksa...
Dialogue: 0,0:16:13.24,0:16:14.24,Default,SOTA,0,0,0,,Hadi ama.
Dialogue: 0,0:16:14.68,0:16:18.75,Default,SOTA,0,0,0,,Bugün bir tuhafsın.\NBir şey mi oldu?
Dialogue: 0,0:16:21.00,0:16:23.00,Default,REN,0,0,0,,İçeceğimi unuttum.
Dialogue: 0,0:16:23.43,0:16:25.28,Default,SOTA,0,0,0,,Buna ne oldu şimdi?
Dialogue: 0,0:16:25.28,0:16:26.76,Default,SHIZUKU,0,0,0,,Sota! Dikkat et!
Dialogue: 0,0:16:29.37,0:16:31.64,Default,SHIZUKU,0,0,0,,Tam isabet!
Dialogue: 0,0:16:32.88,0:16:34.44,Default,SHIZUKU,0,0,0,,Sota-kun!
Dialogue: 0,0:16:34.44,0:16:36.88,Default,MAYO,0,0,0,,Mayolarımızı nasıl buldun?
Dialogue: 0,0:16:40.68,0:16:43.98,Default,SOTA,0,0,0,,İ-İkinize de çok yakışmış.
Dialogue: 0,0:16:43.98,0:16:46.64,Default,SHIZUKU,0,0,0,,Beklediğim tepki bu değildi!
Dialogue: 0,0:16:48.14,0:16:50.56,Default,MAYO,0,0,0,,Ben de kendime epey güveniyordum.
Dialogue: 0,0:16:50.56,0:16:52.36,Default,MAYO,0,0,0,,Hayal kırıklığına uğradım doğrusu.
Dialogue: 0,0:16:52.36,0:16:53.41,Default,SOTA,0,0,0,,Nasıl yani?
Dialogue: 0,0:16:53.41,0:16:54.69,Default,RINKA,0,0,0,,Oshio-san!
Dialogue: 0,0:16:56.28,0:16:57.15,Default,RINKA,0,0,0,,Ş-Şey...
Dialogue: 0,0:16:57.15,0:17:01.53,Default,RINKA,0,0,0,,Bu mayoyu seçmeme\NMayo-san yardım etti de...
Dialogue: 0,0:17:01.53,0:17:03.78,Default,RINKA,0,0,0,,Nasıl olmuş?
Dialogue: 0,0:17:03.78,0:17:06.80,Default,SOTA,0,0,0,,Çok yakışmış.\NGerçekten çok tatlı olmuş.
Dialogue: 0,0:17:07.63,0:17:10.16,Default,RINKA,0,0,0,,Ç-Çok teşekkür ederim.
Dialogue: 0,0:17:12.58,0:17:14.79,Default,MAYO,0,0,0,,Aferin sana. Çok iyi yaptın.
Dialogue: 0,0:17:15.49,0:17:16.98,Default,SHIZUKU,0,0,0,,Ama cidden, Sota-kun,
Dialogue: 0,0:17:16.98,0:17:19.67,Default,SHIZUKU,0,0,0,,Koharu-chan hariç herkese\Nrahat davranabiliyorsun, ha?
Dialogue: 0,0:17:19.67,0:17:22.31,Default,SOTA,0,0,0,,Ne demek istiyorsun, anlamadım.
Dialogue: 0,0:17:22.31,0:17:23.58,Default,SHIZUKU,0,0,0,,Neyse!
Dialogue: 0,0:17:23.58,0:17:27.82,Default,SHIZUKU,0,0,0,,Bakalım Sato-san'la yüz yüze gelince\Nbu rahatlığın kalacak mı?
Dialogue: 0,0:17:28.04,0:17:29.32,Italics,SOTA,0,0,0,,Sato-san mı?!
Dialogue: 0,0:17:29.32,0:17:30.57,Default,SHIZUKU,0,0,0,,Ooo, dur bakalım.
Dialogue: 0,0:17:30.57,0:17:33.64,Default,SHIZUKU,0,0,0,,Daha şimdiden\Nheyecanlanmaya başladın!
Dialogue: 0,0:17:33.64,0:17:37.83,Default,SHIZUKU,0,0,0,,Öyleyse mayolu\NSato-san'ı sahneye alalım!
Dialogue: 0,0:17:41.00,0:17:42.08,Default,SOTA,0,0,0,,Ş-Şey...
Dialogue: 0,0:17:42.08,0:17:43.64,Default,SOTA,0,0,0,,Kimseyi göremiyorum ki...
Dialogue: 0,0:17:43.64,0:17:44.14,Default,SHIZUKU,0,0,0,,Ne?!
Dialogue: 0,0:17:44.14,0:17:44.68,Default,MAYO,0,0,0,,Amanın.
Dialogue: 0,0:17:44.68,0:17:45.32,Default,RINKA,0,0,0,,Ne?!
Dialogue: 0,0:17:48.33,0:17:49.58,Default,SIGN,0,0,0,,{\p1\bord0\an8\shad0\c&HF9FCF9&\frz5.365\fscx279\fscy66\pos(1114.5,378)}m 0 0 l 230 0 l 230 215 l 0 215
Dialogue: 1,0:17:48.33,0:17:49.58,Default,SIGN,0,0,0,,{\an8\fs40\shad0\bord0\c&H6A6676&\frz4.752\pos(1134,417)}Koharu Sato sana bir çıkartma gönderdi.
Dialogue: 0,0:17:49.60,0:17:51.01,Default,SOTA,0,0,0,,Sato-san?
Dialogue: 0,0:17:53.71,0:17:54.66,Default,SOTA,0,0,0,,Bu ne demek şimdi?
Dialogue: 0,0:17:54.66,0:17:55.85,Default,RINKA,0,0,0,,Oshio-san!
Dialogue: 0,0:17:56.46,0:17:58.29,Default,RINKA,0,0,0,,Şuraya bak, kayaların arkasına.
Dialogue: 0,0:17:58.29,0:18:00.32,Default,SOTA,0,0,0,,Ha? Yoksa o...
Dialogue: 0,0:18:00.32,0:18:01.53,Default,MAYO,0,0,0,,Devasa bir...
Dialogue: 0,0:18:01.53,0:18:03.35,Default,SHIZUKU,0,0,0,,...kaya midyesi mi?
Dialogue: 0,0:18:03.83,0:18:05.35,Default,SOTA,0,0,0,,Yoksa o...
Dialogue: 0,0:18:06.60,0:18:08.01,Default,SIGN,0,0,0,,{\p1\bord0\an8\shad0\c&HA4FCDE&\fscx330\fscy48\frz17.29\pos(1003.5,240)}m 0 0 l 230 0 l 230 215 l 0 215
Dialogue: 1,0:18:06.60,0:18:08.01,Default,SIGN,0,0,0,,{\an8\fs78\shad0\bord0\c&H6A6676&\frz15.96\pos(1008,261)}O sen misin, Sato-san?
Dialogue: 0,0:18:08.86,0:18:10.12,Default,SOTA,0,0,0,,Sato-san'mış.
Dialogue: 0,0:18:10.12,0:18:12.12,Default,MAYO,0,0,0,,Kaybolmamış olmasına sevindim.
Dialogue: 0,0:18:12.12,0:18:14.82,Default,SHIZUKU,0,0,0,,Öyle gölgede saklanırsan\Nüzerinde yosun bitecek!
Dialogue: 0,0:18:14.82,0:18:17.11,Default,SHIZUKU,0,0,0,,Hadi! Yüzmeye gidelim!
Dialogue: 0,0:18:15.16,0:18:17.11,Default Top,KOHARU,0,0,0,,B-Ben...
Dialogue: 0,0:18:18.00,0:18:19.37,Default,KOHARU,0,0,0,,Yapamam!
Dialogue: 0,0:18:19.88,0:18:21.31,Default,SHIZUKU,0,0,0,,Ödümü kopardın!
Dialogue: 0,0:18:21.31,0:18:24.26,Default,KOHARU,0,0,0,,Ç-Çok utanıyorum, yerin dibine gireceğim!
Dialogue: 0,0:18:24.26,0:18:26.23,Default,RINKA,0,0,0,,Niye şimdi utanmaya başladın ki?
Dialogue: 0,0:18:26.23,0:18:29.18,Default,MAYO,0,0,0,,Plaja gelmek onun için\Nbiraz fazla gelmiş olabilir.
Dialogue: 0,0:18:29.18,0:18:32.37,Default,SHIZUKU,0,0,0,,Koharu-chan! Böyle yaparsan\Nbütün eğlenceyi kaçıracaksın.
Dialogue: 0,0:18:32.37,0:18:36.60,Default,KOHARU,0,0,0,,Beni merak etmeyin.\NSiz gidip eğlenin lütfen.
Dialogue: 0,0:18:36.60,0:18:38.96,Default,KOHARU,0,0,0,,Ben burada eşyalarımıza göz kulak olurum.
Dialogue: 0,0:18:38.96,0:18:40.37,Default,RINKA,0,0,0,,Hey, Koharu!
Dialogue: 0,0:18:40.37,0:18:41.24,Default,MAYO,0,0,0,,Tamam, sakin.
Dialogue: 0,0:18:41.24,0:18:43.70,Default,MAYO,0,0,0,,Hepimiz etrafını sarınca\Niyice çekinmiş olabilir.
Dialogue: 0,0:18:43.70,0:18:45.88,Default,SHIZUKU,0,0,0,,Peki! O zaman... Sana emanet!
Dialogue: 0,0:18:45.88,0:18:46.52,Default,SOTA,0,0,0,,Ne?!
Dialogue: 0,0:18:46.76,0:18:48.47,Default,RINKA,0,0,0,,A-Ama!
Dialogue: 0,0:18:49.34,0:18:50.27,Default,RINKA,0,0,0,,Ama...
Dialogue: 0,0:18:53.27,0:18:55.69,Default,SOTA,0,0,0,,Şey... Ben de şuraya oturayım.
Dialogue: 0,0:18:55.69,0:18:57.91,Default,KOHARU,0,0,0,,Çok özür dilerim.
Dialogue: 0,0:18:58.39,0:19:02.03,Default,KOHARU,0,0,0,,Benim gibi birini davet etme\Ninceliğini gösterdin, ama ben...
Dialogue: 0,0:19:02.03,0:19:03.90,Default,SOTA,0,0,0,,Öyle deme ya.
Dialogue: 0,0:19:03.90,0:19:06.94,Default,SOTA,0,0,0,,Seni, seninle vakit geçirmek\Nistediğim için çağırdım.
Dialogue: 0,0:19:06.94,0:19:11.67,Default,SOTA,0,0,0,,O yüzden suya girmek istemiyorsan\Nben de burada yanında otururum.
Dialogue: 0,0:19:11.67,0:19:14.53,Default,KOHARU,0,0,0,,A-Ama olmaz ki öyle!
Dialogue: 0,0:19:15.16,0:19:16.43,Default,SOTA,0,0,0,,Sato-san?
Dialogue: 0,0:19:16.84,0:19:19.35,Default,KOHARU,0,0,0,,O-Olmaz işte.
Dialogue: 0,0:19:19.35,0:19:21.14,Default,KOHARU,0,0,0,,Sen git, eğlenmene bak.
Dialogue: 0,0:19:21.14,0:19:23.17,Default,KOHARU,0,0,0,,Lütfen benim için endişelenme.
Dialogue: 0,0:19:24.11,0:19:27.43,Default,SOTA,0,0,0,,Biliyor musun, kendimi bildim bileli\Ndenizi böyle seyretmeyi severim.
Dialogue: 0,0:19:27.43,0:19:29.36,Default,SOTA,0,0,0,,Hep çok sevmişimdir.
Dialogue: 0,0:19:31.00,0:19:32.40,Default,SOTA,0,0,0,,Küçükken,
Dialogue: 0,0:19:32.40,0:19:35.94,Default,SOTA,0,0,0,,Kanami nine beni sık sık yürüyüşe çıkarırdı.
Dialogue: 0,0:19:35.94,0:19:38.17,Default,SOTA,0,0,0,,Kıyı boyunca dolaştırır,
Dialogue: 0,0:19:38.17,0:19:40.45,Default,SOTA,0,0,0,,yol üstündeki tesiste bana\Nkülah dondurma alırdı.
Dialogue: 0,0:19:41.25,0:19:44.05,Default,SOTA,0,0,0,,Bu manzara hep\Nyanı başımdaydı.
Dialogue: 0,0:19:44.44,0:19:46.97,Default,SOTA,0,0,0,,Ben de buna bayılırdım.
Dialogue: 0,0:19:46.97,0:19:48.06,Default,SOTA,0,0,0,,O yüzden...
Dialogue: 0,0:19:48.70,0:19:50.54,Default,SOTA,0,0,0,,Şu an zaten çok mutluyum.
Dialogue: 0,0:19:50.54,0:19:54.71,Default,SOTA,0,0,0,,En sevdiğim manzarayı\Nseninle paylaşabiliyorum.
Dialogue: 0,0:19:54.71,0:19:56.46,Default,KOHARU,0,0,0,,Oshio-kun...
Dialogue: 0,0:19:59.68,0:20:00.91,Default,SOTA,0,0,0,,Sato-san.
Dialogue: 0,0:20:01.50,0:20:03.24,Default,SOTA,0,0,0,,Denizin tadını çıkarmak için
Dialogue: 0,0:20:03.24,0:20:07.05,Default,SOTA,0,0,0,,illa suya girmek ya da\Nmayo giymek gerekmiyor.
Dialogue: 0,0:20:07.05,0:20:07.98,Default,KOHARU,0,0,0,,Gerçekten mi?
Dialogue: 0,0:20:08.52,0:20:09.37,Default,SOTA,0,0,0,,Evet.
Dialogue: 0,0:20:17.00,0:20:19.92,Default,SOTA,0,0,0,,Hepimiz halka olup\NV işareti yapalım!
Dialogue: 0,0:20:19.92,0:20:20.92,Default,RINKA,0,0,0,,V işareti mi?
Dialogue: 0,0:20:20.92,0:20:21.98,Default,MAYO,0,0,0,,V işareti mi?
Dialogue: 0,0:20:22.52,0:20:23.98,Default,SOTA,0,0,0,,Sato-san, sen de.
Dialogue: 0,0:20:23.98,0:20:25.04,Default,KOHARU,0,0,0,,Böyle mi?
Dialogue: 0,0:20:27.62,0:20:29.00,Italics,SOTA,0,0,0,,Ç-Çok tatlı!
Dialogue: 0,0:20:29.27,0:20:31.36,Default,SOTA,0,0,0,,Tamam, şimdi parmaklarınızı aşağı çevirin.
Dialogue: 0,0:20:31.36,0:20:33.34,Default,SHIZUKU,0,0,0,,Haa, anladım.
Dialogue: 0,0:20:33.34,0:20:35.06,Default,MAYO,0,0,0,,Ne yapmaya çalıştığını anladım.
Dialogue: 0,0:20:35.06,0:20:39.26,Default,RINKA,0,0,0,,Böyle çocukça bir fikir bulmana\Nşaşırdım, Oshio-san.
Dialogue: 0,0:20:39.26,0:20:41.04,Default,SOTA,0,0,0,,Hadi, Sato-san.
Dialogue: 0,0:20:41.79,0:20:43.76,Default,SOTA,0,0,0,,Şimdi telefonunu çıkar.
Dialogue: 0,0:20:44.35,0:20:45.45,Default,SHIZUKU,0,0,0,,Tamam!
Dialogue: 0,0:20:45.44,0:20:47.51,Default,SHIZUKU,0,0,0,,Herkes gülümsesin!
Dialogue: 0,0:20:48.23,0:20:51.77,Default,SOTA,0,0,0,,Fotoğrafı Sato-san'a\Nçektirecektim aslında.
Dialogue: 0,0:20:51.77,0:20:53.30,Default,SHIZUKU,0,0,0,,Hadi ama, ne olacak sanki?
Dialogue: 0,0:20:53.30,0:20:55.03,Default,SHIZUKU,0,0,0,,Bak, Koharu-chan!
Dialogue: 0,0:20:55.03,0:20:58.42,Default,SHIZUKU,0,0,0,,Sota-kun'un sana göstermek istediği şey buydu.
Dialogue: 0,0:21:06.04,0:21:07.16,Default,KOHARU,0,0,0,,Bir yıldız...
Dialogue: 0,0:21:07.16,0:21:09.54,Default,SOTA,0,0,0,,Öyle çok özel bir şey değil ama
Dialogue: 0,0:21:09.54,0:21:11.54,Default,SOTA,0,0,0,,en azından hep birlikte yapabiliyoruz.
Dialogue: 0,0:21:13.24,0:21:14.62,Default,KOHARU,0,0,0,,Oshio-kun...
Dialogue: 0,0:21:17.93,0:21:18.94,Default,KOHARU,0,0,0,,Teş...
Dialogue: 0,0:21:19.52,0:21:20.94,Default,KOHARU,0,0,0,,Teşekkür ederim.
Dialogue: 0,0:21:22.05,0:21:25.80,Default,KOHARU,0,0,0,,Seninle plaja geldiğime çok sevindim,
Dialogue: 0,0:21:26.22,0:21:28.30,Default,KOHARU,0,0,0,,Oshio-kun... Aah!
Dialogue: 0,0:21:34.80,0:21:36.44,Default,SOTA,0,0,0,,Sato-san!
Dialogue: 0,0:21:43.20,0:21:45.94,Default,SOTA,0,0,0,,S-Sato-san, şey...
Dialogue: 0,0:21:45.94,0:21:50.18,Default,SOTA,0,0,0,,M-Mayon... sana çok yakışmış.
Dialogue: 0,0:23:35.36,0:23:37.72,Default,SOTA,0,0,0,,Gelecek bölüm: "Aşk Kilidi".
Dialogue: 1,0:23:35.85,0:23:40.10,Default,SIGN,0,0,0,,{\an8\fad(528,1)\fnVerdana\fs51\shad0\c&H7E572F&\3c&HC2B8FB&\blur12\pos(648,444)}Gelecek Bölüm
